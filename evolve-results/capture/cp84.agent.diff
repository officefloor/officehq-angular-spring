+    private static boolean isBusinessDay(LocalDate day, Set<LocalDate> holidays) {
+        DayOfWeek weekday = day.getDayOfWeek();
+        return weekday != DayOfWeek.SATURDAY && weekday != DayOfWeek.SUNDAY && !holidays.contains(day);
