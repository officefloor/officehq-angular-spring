@@ -0,0 +1,52 @@
+package net.officefloor.hq.app.person;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Entity;
+import jakarta.persistence.GeneratedValue;
+import jakarta.persistence.GenerationType;
+import jakarta.persistence.Id;
+import jakarta.persistence.Table;
+
+/** A user watching a person on a sheet, at most once. */
+@Entity
+@Table(name = "person_watch")
+public class Watch {
+
+    @Id
+    @GeneratedValue(strategy = GenerationType.IDENTITY)
+    private Long id;
+
+    @Column(name = "sheet_id", nullable = false)
+    private String sheetId;
+
+    @Column(name = "person_id", nullable = false)
+    private Long personId;
+
+    @Column(name = "user_name", nullable = false)
+    private String userName;
+
+    protected Watch() {
+    }
+
+    public Watch(String sheetId, Long personId, String userName) {
+        this.sheetId = sheetId;
+        this.personId = personId;
+        this.userName = userName;
+    }
+
+    public Long getId() {
+        return id;
+    }
+
+    public String getSheetId() {
+        return sheetId;
+    }
+
+    public Long getPersonId() {
+        return personId;
+    }
+
+    public String getUserName() {
+        return userName;
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/person/WatchRepository.java b/src/main/java/net/officefloor/hq/app/person/WatchRepository.java
