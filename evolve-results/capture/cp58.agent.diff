index 000000000..75fd85c0b
--- /dev/null
+++ b/src/main/resources/db/migration/V42__person_watch.sql
@@ -0,0 +1,10 @@
+-- The users watching a person, each at most once; a watch is dropped when they stop watching, so
+-- the order of ids is the order the current watchers started watching.
+CREATE TABLE person_watch (
+    id        BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id  VARCHAR(100) NOT NULL REFERENCES sheet (id),
+    person_id BIGINT       NOT NULL REFERENCES person (id),
+    user_name VARCHAR(100) NOT NULL,
