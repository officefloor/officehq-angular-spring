+                  ? `This claim is deferred until ${c.deferredUntil} and cannot be split before then.`
+                  : `A ${c.status} claim cannot be split.`
+                : 'Could not split this claim.';
+      this.actionErrors.update((m) => new Map(m).set(c.id, err));
+    }
+  }
