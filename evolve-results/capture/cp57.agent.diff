+      if (this.session.sheetId() !== sheet) return;
+      this.saved.emit(result.original);
+      this.saved.emit(result.split);
+    } catch (e) {
+      if (this.session.sheetId() !== sheet) return;
+      const message = e instanceof HttpErrorResponse && e.status === 423
