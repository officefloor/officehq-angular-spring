+import { HttpClient } from '@angular/common/http';
+import { Component, effect, inject, signal } from '@angular/core';
+import { firstValueFrom } from 'rxjs';
+import { Session } from '../../core/session';
+import { PersonWithClaims as Person } from '../claims/claims';
+
+/** The person's due-total in the latest snapshot written on leaving the day; '' when there is none. */
+function snapshotOn(p: Person, day: string): string {
+  const found = p.snapshots.filter((s) => s.day === day);
+  return found.length === 0 ? '' : found[found.length - 1].dueTotal;
+}
+
+// The snapshot comparison: per person in list order, <name> <then> <now>, where then is their due-total in the
+// SNAPSHOT written when the sheet's today was changed away from the from-date (blank: the sheet's today) and now
+// likewise for the to-date, or their due-total now when the to-date is blank; a figure with no snapshot is empty,
+// and each line is trimmed. It reads the store; it records nothing.
+@Component({
+  selector: 'app-snapshot-compare',
+  template: `
+    <section aria-label="Snapshot comparison">
+      <h2>Snapshot comparison</h2>
+      <form (submit)="compare($event)" aria-label="Compare snapshots">
+        <label for="snapshot-from">From (blank: today)</label>
+        <input
+          id="snapshot-from"
+          data-testid="snapshot-from"
+          [value]="from()"
+          (input)="from.set(value($event)); error.set('')"
+        />
+        <label for="snapshot-to">To (blank: now)</label>
+        <input
+          id="snapshot-to"
+          data-testid="snapshot-to"
+          [value]="to()"
+          (input)="to.set(value($event)); error.set('')"
+        />
+        <button type="submit" data-testid="snapshot-compare">Compare</button>
+        @if (error()) {
+          <p role="alert" data-testid="snapshot-compare-error">{{ error() }}</p>
+        }
+      </form>
+      <ol>
+        @for (line of lines(); track $index) {
+          <li data-testid="snapshot-line">{{ line }}</li>
+        }
+      </ol>
+    </section>
+  `,
+})
+export class SnapshotCompare {
+  private readonly http = inject(HttpClient);
+  private readonly session = inject(Session);
+
+  protected readonly from = signal('');
+  protected readonly to = signal('');
+  protected readonly lines = signal<string[]>([]);
+  protected readonly error = signal('');
+  /** Bumped on every press, so only the latest press's answer is shown. */
+  private compares = 0;
+
+  constructor() {
+    effect(() => {
+      this.session.sheet();
+      this.session.loads();
+      this.compares++;
+      this.lines.set([]);
+      this.error.set('');
+    });
+  }
+
+  protected value(e: Event): string {
+    return (e.target as HTMLInputElement).value;
+  }
+
+  protected async compare(e: Event): Promise<void> {
+    e.preventDefault();
+    const sheet = this.session.sheet();
+    if (!sheet) return;
+    const compare = ++this.compares;
+    this.lines.set([]);
+    this.error.set('');
+    const from = this.from().trim() || (this.session.today() ?? '');
+    const to = this.to().trim();
+    if (!/^\d{4}-\d{2}-\d{2}$/.test(from) || (to && !/^\d{4}-\d{2}-\d{2}$/.test(to))) {
+      this.error.set('Enter the dates as yyyy-mm-dd.');
+      return;
+    }
+    try {
+      const people = await firstValueFrom(this.http.get<Person[]>(`/api/sheets/${encodeURIComponent(sheet)}/people`));
+      if (compare !== this.compares) return;
+      this.lines.set(
+        people.map((p) => {
+          const then = snapshotOn(p, from);
+          const now = to ? snapshotOn(p, to) : (p.dueTotal ?? 'n/a');
+          return `${p.name} ${then} ${now}`.trim();
+        }),
+      );
+    } catch {
+      if (compare === this.compares) this.error.set('Could not compare the snapshots.');
+    }
+  }
+}
