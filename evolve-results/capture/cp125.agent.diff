+
+    public LocalDate getToDate() {
+        return toDate;
+    }
+
+    /** Whether a day falls after the from-date and before the to-date. */
+    public boolean within(LocalDate day) {
+        return day.isAfter(fromDate) && day.isBefore(toDate);
+    }
+}
