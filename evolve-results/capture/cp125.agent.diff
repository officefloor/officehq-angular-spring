diff --git a/src/main/java/net/officefloor/hq/app/person/Retirement.java b/src/main/java/net/officefloor/hq/app/person/Retirement.java
new file mode 100644
index 00000000..b0b8deac
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/person/Retirement.java
@@ -0,0 +1,38 @@
+package net.officefloor.hq.app.person;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Embeddable;
+import java.time.LocalDate;
+
+/** A past retirement of a person: from its date to the day they were unretired. */
+@Embeddable
+public class Retirement {
+
+    @Column(name = "from_date", nullable = false)
+    private LocalDate fromDate;
+
+    @Column(name = "to_date", nullable = false)
+    private LocalDate toDate;
+
+    protected Retirement() {
+    }
+
+    public Retirement(LocalDate fromDate, LocalDate toDate) {
+        this.fromDate = fromDate;
+        this.toDate = toDate;
+    }
+
+    public LocalDate getFromDate() {
+        return fromDate;
+    }
+
+    /** The day the person was unretired. */
+    public LocalDate getToDate() {
+        return toDate;
+    }
+
+    /** Whether a date falls strictly between the retirement's from and to: no claim may be dated on it. */
+    public boolean bars(LocalDate date) {
+        return date.isAfter(fromDate) && date.isBefore(toDate);
+    }
+}
diff --git a/src/main/resources/db/migration/V73__person_retirement.sql b/src/main/resources/db/migration/V73__person_retirement.sql
new file mode 100644
index 00000000..de7b7248
--- /dev/null
+++ b/src/main/resources/db/migration/V73__person_retirement.sql
@@ -0,0 +1,10 @@
+-- A retired person can be unretired: they are no longer retired, and the retirement is kept as a
+-- past one, from its date to the day they were unretired. A person may have several over time; no
+-- claim dated after the from and before the to of one can be added for them.
+CREATE TABLE person_retirement (
+    person_id BIGINT NOT NULL REFERENCES person (id),
+    retirement_order INT NOT NULL,
+    from_date DATE   NOT NULL,
+    to_date   DATE   NOT NULL,
+    PRIMARY KEY (person_id, retirement_order)
+);
