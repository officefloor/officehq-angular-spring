diff --git a/src/main/java/net/officefloor/hq/app/claim/ClaimReviewAssignException.java b/src/main/java/net/officefloor/hq/app/claim/ClaimReviewAssignException.java
new file mode 100644
index 000000000..6a6b94328
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/ClaimReviewAssignException.java
@@ -0,0 +1,13 @@
+package net.officefloor.hq.app.claim;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.ResponseStatus;
+
+/** A review assigned on a claim not in REVIEW. */
+@ResponseStatus(HttpStatus.CONFLICT)
+public class ClaimReviewAssignException extends RuntimeException {
+
+    public ClaimReviewAssignException(Long id, ClaimStatus status) {
+        super("Claim " + id + " is " + status + ": only a REVIEW claim can have its review assigned");
+    }
+}
