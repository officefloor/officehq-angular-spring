+    /**
+     * The duplicate claims: for each person, date and amount with two or more claims (VOID and DELETED claims left
+     * out), one line {@code <name> <date> <amount> x<count>}; people in list order, then by date, then by amount.
+     */
+    @Transactional(readOnly = true)
+    public List<String> duplicates(String sheetId) {
+        Map<Long, Map<LocalDate, Map<BigDecimal, Integer>>> counts = new HashMap<>();
+        for (Claim claim : claims.findBySheetIdOrderByIdDesc(sheetId)) {
+            if (claim.getStatus() == ClaimStatus.VOID || claim.getStatus() == ClaimStatus.DELETED) {
+                continue;
+            }
+            counts.computeIfAbsent(claim.getPersonId(), p -> new TreeMap<>())
+                    .computeIfAbsent(claim.getDate(), d -> new TreeMap<>())
+                    .merge(claim.getAmount().setScale(2, RoundingMode.UNNECESSARY), 1, Integer::sum);
+        }
+        List<String> lines = new ArrayList<>();
+        for (Person person : people.findBySheetIdOrderByPositionAscIdAsc(sheetId)) {
+            counts.getOrDefault(person.getId(), Map.of()).forEach((date, amounts) -> amounts.forEach((amount, count) -> {
+                if (count >= 2) {
+                    lines.add(person.getName() + " " + date + " " + amount.toPlainString() + " x" + count);
+                }
+            }));
+        }
+        return lines;
+    }
