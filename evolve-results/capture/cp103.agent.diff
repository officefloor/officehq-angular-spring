+package net.officefloor.hq.app.template;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Entity;
+import jakarta.persistence.GeneratedValue;
+import jakarta.persistence.GenerationType;
+import jakarta.persistence.Id;
+import jakarta.persistence.Table;
+import java.math.BigDecimal;
+
+/** A sheet's claim template: a name, and the amount and note a claim made from it takes at that moment. */
+@Entity
+@Table(name = "claim_template")
+public class ClaimTemplate {
+
+    @Id
+    @GeneratedValue(strategy = GenerationType.IDENTITY)
+    private Long id;
+
+    @Column(name = "sheet_id", nullable = false)
+    private String sheetId;
+
+    @Column(name = "name", nullable = false)
+    private String name;
+
+    @Column(name = "amount", nullable = false, precision = 15, scale = 2)
+    private BigDecimal amount;
+
+    @Column(name = "note", nullable = false)
+    private String note;
+
+    protected ClaimTemplate() {
+    }
+
+    public ClaimTemplate(String sheetId, String name, BigDecimal amount, String note) {
+        this.sheetId = sheetId;
+        this.name = name;
+        this.amount = amount;
+        this.note = note;
+    }
+
+    public Long getId() {
+        return id;
+    }
+
+    public String getSheetId() {
+        return sheetId;
+    }
+
+    public String getName() {
+        return name;
+    }
+
+    public BigDecimal getAmount() {
+        return amount;
+    }
+
+    public String getNote() {
+        return note;
+    }
+
+    /** Replace the template's amount and note: claims already made from it keep theirs. */
+    public void replace(BigDecimal amount, String note) {
+        this.amount = amount;
+        this.note = note;
+    }
+}
