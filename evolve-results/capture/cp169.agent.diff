diff --git a/src/main/java/net/officefloor/hq/app/person/TermsFrom.java b/src/main/java/net/officefloor/hq/app/person/TermsFrom.java
new file mode 100644
index 000000000..55f3ef92f
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/person/TermsFrom.java
@@ -0,0 +1,32 @@
+package net.officefloor.hq.app.person;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Embeddable;
+import java.time.LocalDate;
+
+/** A person's own terms (null: none), from a date. */
+@Embeddable
+public class TermsFrom {
+
+    @Column(name = "terms")
+    private Integer terms;
+
+    @Column(name = "from_date", nullable = false)
+    private LocalDate fromDate;
+
+    protected TermsFrom() {
+    }
+
+    public TermsFrom(Integer terms, LocalDate fromDate) {
+        this.terms = terms;
+        this.fromDate = fromDate;
+    }
+
+    public Integer getTerms() {
+        return terms;
+    }
+
+    public LocalDate getFromDate() {
+        return fromDate;
+    }
+}
diff --git a/src/main/resources/db/migration/V87__person_terms_dated.sql b/src/main/resources/db/migration/V87__person_terms_dated.sql
new file mode 100644
index 000000000..a0a3c8167
--- /dev/null
+++ b/src/main/resources/db/migration/V87__person_terms_dated.sql
@@ -0,0 +1,9 @@
+-- A person's own terms, each from a date: the one whose from-date is the latest on or before a date is in
+-- force then (terms null: none from that date, their grade's or the sheet's); before the first of them, the
+-- terms on the person (no from-date) apply from the beginning of time.
+CREATE TABLE person_terms (
+    person_id BIGINT NOT NULL REFERENCES person (id),
+    terms     INT,
+    from_date DATE   NOT NULL
+);
+CREATE INDEX person_terms_person ON person_terms (person_id);
