diff --git a/src/main/java/net/officefloor/hq/app/person/PersonTerms.java b/src/main/java/net/officefloor/hq/app/person/PersonTerms.java
new file mode 100644
index 00000000..ce3d19df
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/person/PersonTerms.java
@@ -0,0 +1,32 @@
+package net.officefloor.hq.app.person;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Embeddable;
+import java.time.LocalDate;
+
+/** A person's own terms in force from {@code from}; null terms are none of their own from then. */
+@Embeddable
+public class PersonTerms {
+
+    @Column(name = "terms")
+    private Integer terms;
+
+    @Column(name = "terms_from", nullable = false)
+    private LocalDate from;
+
+    protected PersonTerms() {
+    }
+
+    public PersonTerms(Integer terms, LocalDate from) {
+        this.terms = terms;
+        this.from = from;
+    }
+
+    public Integer getTerms() {
+        return terms;
+    }
+
+    public LocalDate getFrom() {
+        return from;
+    }
+}
diff --git a/src/main/resources/db/migration/V92__person_terms_dated.sql b/src/main/resources/db/migration/V92__person_terms_dated.sql
new file mode 100644
index 00000000..260886d7
--- /dev/null
+++ b/src/main/resources/db/migration/V92__person_terms_dated.sql
@@ -0,0 +1,9 @@
+-- A person's own terms dated from a day: the one with the latest from-date on or before a claim's date
+-- is in force for it (null terms: none of their own then); before the first, the person's undated terms
+-- apply, from the beginning of time.
+CREATE TABLE person_terms (
+    person_id  BIGINT  NOT NULL REFERENCES person (id),
+    terms      INTEGER CHECK (terms >= 0),
+    terms_from DATE    NOT NULL
+);
+CREATE INDEX person_terms_person ON person_terms (person_id);
