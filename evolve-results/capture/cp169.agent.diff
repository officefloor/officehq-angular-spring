diff --git a/src/main/resources/db/migration/V91__person_terms_dated.sql b/src/main/resources/db/migration/V91__person_terms_dated.sql
new file mode 100644
index 000000000..2d309974b
--- /dev/null
+++ b/src/main/resources/db/migration/V91__person_terms_dated.sql
@@ -0,0 +1,9 @@
+-- A person's own terms, each from a from-date until their next; null terms: none from that date.
+-- The person's terms column holds the ones from the beginning of time.
+CREATE TABLE person_terms (
+    person_id BIGINT  NOT NULL REFERENCES person (id),
+    from_date DATE    NOT NULL,
+    terms     INTEGER CHECK (terms >= 0),
