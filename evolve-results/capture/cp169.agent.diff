diff --git a/src/main/java/net/officefloor/hq/app/person/TermsFrom.java b/src/main/java/net/officefloor/hq/app/person/TermsFrom.java
new file mode 100644
index 000000000..fd0e6931c
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/person/TermsFrom.java
@@ -0,0 +1,36 @@
+package net.officefloor.hq.app.person;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Embeddable;
+import java.time.LocalDate;
+import java.util.Comparator;
+
+/** Terms a person has from a date until their next dated ones'; null terms are none of their own then. */
+@Embeddable
+public class TermsFrom {
+
+    /** Orders dated terms by the date they take effect. */
+    public static final Comparator<TermsFrom> BY_FROM = Comparator.comparing(TermsFrom::getFromDate);
+
+    @Column(name = "from_date", nullable = false)
+    private LocalDate fromDate;
+
+    @Column(name = "terms")
+    private Integer terms;
+
+    protected TermsFrom() {
+    }
+
+    public TermsFrom(LocalDate fromDate, Integer terms) {
+        this.fromDate = fromDate;
+        this.terms = terms;
+    }
+
+    public LocalDate getFromDate() {
+        return fromDate;
+    }
+
+    public Integer getTerms() {
+        return terms;
+    }
+}
diff --git a/src/main/resources/db/migration/V92__person_terms_dated.sql b/src/main/resources/db/migration/V92__person_terms_dated.sql
new file mode 100644
index 000000000..be3ce0ab6
--- /dev/null
+++ b/src/main/resources/db/migration/V92__person_terms_dated.sql
@@ -0,0 +1,9 @@
+-- A person's own terms can be dated: each dated terms are in force from their from-date until the next
+-- one's; null terms are none of the person's own then. Before the earliest from-date, the person's undated
+-- terms (person.terms) are in force. A person has at most one terms per from-date.
+CREATE TABLE person_terms (
+    person_id BIGINT NOT NULL REFERENCES person (id),
+    from_date DATE   NOT NULL,
+    terms     INTEGER
+);
+CREATE INDEX person_terms_person ON person_terms (person_id);
