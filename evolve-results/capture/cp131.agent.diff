@@ -0,0 +1,102 @@
+import { Component, computed, effect, inject, input, signal } from '@angular/core';
+import { FormControl, FormGroup, ReactiveFormsModule } from '@angular/forms';
+import { Session } from '../../core/session';
+import { Plans } from './plans-api';
+
+const AMOUNT = /^\d{1,10}(\.\d{1,2})?$/;
+const EVERY = /^\d{1,6}$/;
+const DATE = /^\d{4}-\d{2}-\d{2}$/;
+
+// A person's plans, each with how many claims it has made so far, and a form to add one.
+@Component({
+  selector: 'app-person-plans',
+  imports: [ReactiveFormsModule],
+  template: `
+    <ul [attr.aria-label]="'Plans of ' + personName()">
+      @for (pl of plans(); track pl.id) {
+        <li [attr.data-testid]="'plan-row-' + pl.id">
+          <span data-testid="plan-amount-shown">{{ pl.amount }}</span> every {{ pl.every }} days
+          from {{ pl.start }} to {{ pl.end }}; made <span data-testid="plan-generated">{{ pl.generated }}</span>
+        </li>
+      }
+    </ul>
+    <form [formGroup]="form" (ngSubmit)="submit()" [attr.aria-label]="'Add a plan for ' + personName()">
+      <label [for]="'plan-form-amount-' + personId()">Amount</label>
+      <input [id]="'plan-form-amount-' + personId()" data-testid="plan-form-amount" formControlName="amount" inputmode="decimal" />
+      <label [for]="'plan-form-start-' + personId()">Start</label>
+      <input [id]="'plan-form-start-' + personId()" type="date" data-testid="plan-form-start" formControlName="start" />
+      <label [for]="'plan-form-every-' + personId()">Every (days)</label>
+      <input [id]="'plan-form-every-' + personId()" data-testid="plan-form-every" formControlName="every" inputmode="numeric" />
+      <label [for]="'plan-form-end-' + personId()">End</label>
+      <input [id]="'plan-form-end-' + personId()" type="date" data-testid="plan-form-end" formControlName="end" />
+      <button type="submit" data-testid="plan-form-submit" [disabled]="saving()">Add plan</button>
+      @if (error()) {
+        <p role="alert" data-testid="plan-error">{{ error() }}</p>
+      }
+    </form>
+  `,
+})
+export class PersonPlans {
+  private readonly session = inject(Session);
+  private readonly store = inject(Plans);
+
+  readonly personId = input.required<number>();
+  readonly personName = input.required<string>();
+
+  protected readonly plans = computed(() => this.store.plans().filter((p) => p.personId === this.personId()));
+
+  protected readonly form = new FormGroup({
+    amount: new FormControl('', { nonNullable: true }),
+    start: new FormControl('', { nonNullable: true }),
+    every: new FormControl('', { nonNullable: true }),
+    end: new FormControl('', { nonNullable: true }),
+  });
+  protected readonly saving = signal(false);
+  protected readonly error = signal('');
+
+  constructor() {
+    this.form.valueChanges.subscribe(() => this.error.set(''));
+    // Each load of a sheet starts the form afresh.
+    effect(() => {
+      this.session.loaded();
+      this.error.set('');
+      this.form.reset({ amount: '', start: '', every: '', end: '' }, { emitEvent: false });
+    });
+  }
+
+  protected async submit(): Promise<void> {
+    if (this.saving()) return;
+    const sheet = this.session.sheet();
+    if (!sheet) return;
+    this.error.set('');
+    const v = this.form.getRawValue();
+    const amount = v.amount.trim();
+    const start = v.start.trim();
+    const every = v.every.trim();
+    const end = v.end.trim();
+    if (!AMOUNT.test(amount) || Number(amount) <= 0) {
+      this.error.set('Enter an amount above 0.00 with up to two decimals.');
+      return;
+    }
+    if (!EVERY.test(every) || Number(every) < 1) {
+      this.error.set('Enter every as a whole number of days, at least 1.');
+      return;
+    }
+    if ((start !== '' && !DATE.test(start)) || !DATE.test(end)) {
+      this.error.set('Enter the start and end dates as yyyy-mm-dd.');
+      return;
+    }
+    if (end < (start || sheet.today)) {
+      this.error.set('The end date cannot be before the start date.');
+      return;
+    }
+    this.saving.set(true);
+    try {
+      await this.store.add(sheet.id, this.personId(), { amount, start: start || null, every, end });
+    } catch {
+      if (this.session.sheet()?.id === sheet.id) this.error.set('The plan could not be added.');
+    } finally {
+      this.saving.set(false);
+    }
+  }
+}
diff --git a/src/main/frontend/src/app/features/plans/plans-api.ts b/src/main/frontend/src/app/features/plans/plans-api.ts
new file mode 100644
index 00000000..5915ff63
--- /dev/null
+++ b/src/main/frontend/src/app/features/plans/plans-api.ts
@@ -0,0 +1,101 @@
+import { HttpClient } from '@angular/common/http';
+import { Injectable, effect, inject, signal } from '@angular/core';
+import { firstValueFrom } from 'rxjs';
+import { Session } from '../../core/session';
+import { ClaimView } from '../claims/claims-api';
+
+/** A person's plan: a claim of the amount (two decimals) on the start date and every `every` days after
+ *  it, up to the end date (yyyy-mm-dd). Generated is how many claims it has made so far. */
+export interface PlanView {
+  id: number;
+  personId: number;
+  amount: string;
+  start: string;
+  every: number;
+  end: string;
+  generated: number;
+}
+
+/** A plan's fields as entered; a null start is the sheet's today. */
+export interface PlanFields {
+  amount: string;
+  start: string | null;
+  every: string;
+  end: string;
+}
+
+/** What a generate made: how many claims, the claims oldest first, and the sheet's plans then. */
+export interface GenerateView {
+  generated: number;
+  claims: ClaimView[];
+  plans: PlanView[];
+}
+
+// The plans of a sheet, as the store holds them.
+@Injectable({ providedIn: 'root' })
+export class PlansApi {
+  private readonly http = inject(HttpClient);
+
+  private url(sheetId: string): string {
+    return `/api/sheets/${encodeURIComponent(sheetId)}/plans`;
+  }
+
+  /** The sheet's plans in the order they were added. */
+  list(sheetId: string): Promise<PlanView[]> {
+    return firstValueFrom(this.http.get<PlanView[]>(this.url(sheetId)));
+  }
+
+  /** Add a plan to a person: refused for an amount not above 0.00 with up to two decimals, an interval
+   *  that is not a whole number of at least 1, or an end before the start. */
+  add(sheetId: string, personId: number, f: PlanFields): Promise<PlanView> {
+    return firstValueFrom(this.http.post<PlanView>(this.url(sheetId),
+      { personId, amount: f.amount, start: f.start, every: f.every, end: f.end }));
+  }
+
+  /** Make every plan's claims due by the sheet's today. */
+  generate(sheetId: string): Promise<GenerateView> {
+    return firstValueFrom(this.http.post<GenerateView>(`${this.url(sheetId)}/generate`, {}));
+  }
+}
+
+// The active sheet's plans. Each load of a sheet re-reads them from the store.
+@Injectable({ providedIn: 'root' })
+export class Plans {
+  private readonly session = inject(Session);
+  private readonly api = inject(PlansApi);
+
+  private readonly state = signal<PlanView[]>([]);
+  readonly plans = this.state.asReadonly();
+
+  constructor() {
+    effect(() => {
+      const sheet = this.session.loaded();
+      this.state.set([]);
+      if (sheet) void this.load(sheet.id);
+    });
+  }
+
+  private async load(sheetId: string): Promise<void> {
+    try {
+      const list = await this.api.list(sheetId);
+      if (this.session.sheet()?.id === sheetId) this.state.set(list);
+    } catch {
+      // The list stays empty; the next load of the sheet re-reads it.
+    }
+  }
+
+  /** Add a plan to a person of the active sheet. */
+  async add(sheetId: string, personId: number, f: PlanFields): Promise<void> {
+    const added = await this.api.add(sheetId, personId, f);
+    if (this.session.sheet()?.id !== sheetId) return;
+    this.state.update((list) => [...list.filter((p) => p.id !== added.id), added]);
+  }
+
+  /** Generate the plans' claims: the store's plans replace those shown. */
+  async generate(sheetId: string): Promise<GenerateView | null> {
+    const result = await this.api.generate(sheetId);
+    if (this.session.sheet()?.id !== sheetId) return null;
+    this.state.set(result.plans);
+    return result;
+  }
+}
