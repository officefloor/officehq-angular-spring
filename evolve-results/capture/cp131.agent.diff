+package net.officefloor.hq.app.plan;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Entity;
+import jakarta.persistence.GeneratedValue;
+import jakarta.persistence.GenerationType;
+import jakarta.persistence.Id;
+import jakarta.persistence.Table;
+import java.math.BigDecimal;
+import java.time.LocalDate;
+
+/** A person's plan on a sheet: an amount claimed on its start date and every so many days after, up to its end
+ *  date. */
+@Entity
+@Table(name = "plan")
+public class Plan {
+
+    @Id
+    @GeneratedValue(strategy = GenerationType.IDENTITY)
+    private Long id;
+
+    @Column(name = "sheet_id", nullable = false)
+    private String sheetId;
+
+    @Column(name = "person_id", nullable = false)
+    private Long personId;
+
+    @Column(name = "amount", nullable = false, precision = 14, scale = 2)
+    private BigDecimal amount;
+
+    @Column(name = "start_date", nullable = false)
+    private LocalDate start;
+
+    @Column(name = "every_days", nullable = false)
+    private int every;
+
+    @Column(name = "end_date", nullable = false)
+    private LocalDate end;
+
+    protected Plan() {
+    }
+
+    public Plan(String sheetId, Long personId, BigDecimal amount, LocalDate start, int every, LocalDate end) {
+        this.sheetId = sheetId;
+        this.personId = personId;
+        this.amount = amount;
+        this.start = start;
+        this.every = every;
+        this.end = end;
+    }
+
+    public Long getId() {
+        return id;
+    }
+
+    public String getSheetId() {
+        return sheetId;
+    }
+
+    public Long getPersonId() {
+        return personId;
+    }
+
+    public BigDecimal getAmount() {
+        return amount;
+    }
+
+    public LocalDate getStart() {
+        return start;
+    }
+
+    public int getEvery() {
+        return every;
+    }
+
+    public LocalDate getEnd() {
+        return end;
+    }
+
+    /** Move the plan to another person, as merging its person into them does. */
+    public void reassign(Long personId) {
+        this.personId = personId;
+    }
+}
