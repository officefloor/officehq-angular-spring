diff --git a/src/main/java/net/officefloor/hq/app/person/PersonVersionConflictException.java b/src/main/java/net/officefloor/hq/app/person/PersonVersionConflictException.java
new file mode 100644
index 000000000..5590dcfef
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/person/PersonVersionConflictException.java
@@ -0,0 +1,16 @@
+package net.officefloor.hq.app.person;
+
+/** Someone else saved the person after the editor loaded it; carries the person as it is now. */
+public class PersonVersionConflictException extends RuntimeException {
+
+    private final transient Person current;
+
+    public PersonVersionConflictException(Person current) {
+        super("Someone else has changed this person.");
+        this.current = current;
+    }
+
+    public Person getCurrent() {
+        return current;
+    }
+}
