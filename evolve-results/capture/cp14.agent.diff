diff --git a/src/main/resources/db/migration/V12__person_version.sql b/src/main/resources/db/migration/V12__person_version.sql
new file mode 100644
index 000000000..01606537e
--- /dev/null
+++ b/src/main/resources/db/migration/V12__person_version.sql
@@ -0,0 +1,3 @@
+-- The version of a person, raised each time they are saved. An editor saves only over the version
+-- it loaded, so a save that another user overtook is refused.
+ALTER TABLE person ADD COLUMN version BIGINT DEFAULT 0 NOT NULL;
