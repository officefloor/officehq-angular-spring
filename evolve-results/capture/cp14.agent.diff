diff --git a/src/main/java/net/officefloor/hq/app/person/PersonStaleException.java b/src/main/java/net/officefloor/hq/app/person/PersonStaleException.java
new file mode 100644
index 00000000..d9505962
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/person/PersonStaleException.java
@@ -0,0 +1,16 @@
+package net.officefloor.hq.app.person;
+
+/** Saving a person from an editor that loaded a version another user has since saved over. */
+public class PersonStaleException extends RuntimeException {
+
+    private final Person current;
+
+    public PersonStaleException(Person current) {
+        this.current = current;
+    }
+
+    /** The person as now stored. */
+    public Person getCurrent() {
+        return current;
+    }
+}
