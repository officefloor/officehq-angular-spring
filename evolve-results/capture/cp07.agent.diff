+package net.officefloor.hq.app.rate;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Entity;
+import jakarta.persistence.GeneratedValue;
+import jakarta.persistence.GenerationType;
+import jakarta.persistence.Id;
+import jakarta.persistence.Table;
+import java.math.BigDecimal;
+
+/** The sheet's rate for one grade: a percent with two decimals (0.00 or more). */
+@Entity
+@Table(name = "rate")
+public class Rate {
+
+    @Id
+    @GeneratedValue(strategy = GenerationType.IDENTITY)
+    private Long id;
+
+    @Column(name = "sheet_id", nullable = false)
+    private String sheetId;
+
+    @Column(name = "grade", nullable = false)
+    private String grade;
+
+    @Column(name = "pct", nullable = false, precision = 7, scale = 2)
+    private BigDecimal pct;
+
+    protected Rate() {}
+
+    public Rate(String sheetId, String grade, BigDecimal pct) {
+        this.sheetId = sheetId;
+        this.grade = grade;
+        this.pct = pct;
+    }
+
+    public Long getId() { return id; }
+
+    public String getSheetId() { return sheetId; }
+
+    public String getGrade() { return grade; }
+
+    public BigDecimal getPct() { return pct; }
+
+    public void setPct(BigDecimal pct) { this.pct = pct; }
+}
