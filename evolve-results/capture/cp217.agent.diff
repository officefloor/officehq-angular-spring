+    @Transactional
+    public Claim share(String sheetId, String user, long claimId, long withPersonId, BigDecimal share) {
+        if (share.signum() <= 0) {
+            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "A share must be above 0.00");
