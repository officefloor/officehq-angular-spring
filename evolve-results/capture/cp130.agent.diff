+/** Two-decimal money text as cents. */
+function cents(amount: string): bigint {
+  const negative = amount.startsWith('-');
+  const [whole, frac = ''] = amount.replace('-', '').split('.');
+  const h = BigInt(whole || '0') * 100n + BigInt((frac + '00').slice(0, 2));
+  return negative ? -h : h;
+}
