@@ -0,0 +1,10 @@
+-- The people a person has named as their patrons, each at most once, never the person themselves.
+CREATE TABLE person_patron (
+    id        BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id  VARCHAR(100) NOT NULL REFERENCES sheet (id),
+    person_id BIGINT       NOT NULL REFERENCES person (id),
+    patron_id BIGINT       NOT NULL REFERENCES person (id),
+    CHECK (person_id <> patron_id)
+);
+CREATE UNIQUE INDEX person_patron_once ON person_patron (person_id, patron_id);
+CREATE INDEX person_patron_sheet ON person_patron (sheet_id, person_id, id);
