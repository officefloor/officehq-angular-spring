diff --git a/src/main/resources/db/migration/V22__person_patron.sql b/src/main/resources/db/migration/V22__person_patron.sql
new file mode 100644
index 00000000..aaccd62d
--- /dev/null
+++ b/src/main/resources/db/migration/V22__person_patron.sql
@@ -0,0 +1,7 @@
+-- A person's patrons: other people on the same sheet they have named, each at most once.
+CREATE TABLE person_patron (
+    person_id BIGINT NOT NULL REFERENCES person (id),
+    patron_id BIGINT NOT NULL REFERENCES person (id),
+    PRIMARY KEY (person_id, patron_id),
+    CHECK (person_id <> patron_id)
+);
