diff --git a/src/main/resources/db/migration/V119__plan_claim.sql b/src/main/resources/db/migration/V119__plan_claim.sql
new file mode 100644
index 000000000..51a5eefe1
--- /dev/null
+++ b/src/main/resources/db/migration/V119__plan_claim.sql
@@ -0,0 +1,6 @@
+-- The claims a plan has made, so a change of its amount can reach those still DRAFT.
+CREATE TABLE plan_claim (
+    plan_id  BIGINT NOT NULL REFERENCES plan (id),
+    claim_id BIGINT NOT NULL,
+    PRIMARY KEY (plan_id, claim_id)
+);
