+    private static Map<String, String> fields(String line) {
+        Map<String, String> fields = new HashMap<>();
+        Matcher m = FIELD.matcher(line);
+        while (m.find()) {
+            fields.putIfAbsent(m.group(1), m.group(2));
+        }
+        return fields;
+    }
