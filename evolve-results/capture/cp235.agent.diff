+    const date = /^\d{4}-\d{2}-\d{2}$/;
+    if ((from && !date.test(from)) || (to && !date.test(to))) {
+      refuse('Enter dates, or leave the from-date blank for today and the to-date blank for no end.');
+      return;
+    }
+    this.bulkRunning = true;
+    try {
