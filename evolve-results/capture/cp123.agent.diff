+  protected async retireSelected(from: string): Promise<void> {
+    if (this.retiringAll) return;
+    this.bulkRetired.set(null);
+    this.bulkRetireError.set('');
+    const ids = this.shown().filter((p) => this.selectedPeople().has(p.id)).map((p) => p.id);
