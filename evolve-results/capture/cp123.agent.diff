+            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "No such person.");
+        }
+        List<Person> saved = new ArrayList<>();
+        for (Person p : chosen) {
+            saved.add(retire(by, sheetId, p.getId(), from));
+        }
+        return saved;
