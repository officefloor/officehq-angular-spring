+  // The average heave among the people not on hold (n/a heaves skipped), rounded like every
+  // divide; null (n/a) when nobody has one.
+  protected readonly heaveMean = computed(() => {
+    const values = (this.people() ?? [])
+      .filter((p) => !p.hold)
+      .map((p) => p.heave)
+      .filter((v): v is number => v !== null);
+    return values.length === 0
+      ? null
+      : divide(values.reduce((total, v) => total + v, 0), values.length);
+  });
