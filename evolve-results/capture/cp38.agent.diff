      * overdue. Settled figures keep what they were; the live figures it moves are rolled up.
diff --git a/src/main/resources/db/migration/V28__grade_terms_claim_due_by.sql b/src/main/resources/db/migration/V28__grade_terms_claim_due_by.sql
