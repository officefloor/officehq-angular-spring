         sheet.setToday(today);
         return sheet;
     }
+
+    /** The next claim number on the sheet: 1 for its first, then 2, and so on, never given twice. */
+    @Transactional
+    public int nextClaimNumber(String id) {
+        if (sheets.advanceClaimNumber(id) == 0) throw new SheetNotFoundException();
+        return sheets.lastClaimNumber(id);
+    }
 }
diff --git a/src/main/resources/db/migration/V8__claim_number.sql b/src/main/resources/db/migration/V8__claim_number.sql
new file mode 100644
index 00000000..f690226d
--- /dev/null
+++ b/src/main/resources/db/migration/V8__claim_number.sql
@@ -0,0 +1,5 @@
+-- A claim's number: given when it is opened, the next on its sheet (1, 2, ...), never reused.
+-- A DRAFT claim has none; voiding a claim clears it. The sheet keeps the last number it gave.
+ALTER TABLE sheet ADD COLUMN last_claim_number INT DEFAULT 0 NOT NULL;
+ALTER TABLE claim ADD COLUMN claim_number INT;
+ALTER TABLE claim ADD CONSTRAINT claim_number_unique UNIQUE (sheet_id, claim_number);
