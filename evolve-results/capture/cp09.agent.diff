+++ b/src/main/java/net/officefloor/hq/app/sheet/SheetRepository.java
@@ -1,6 +1,16 @@
 package net.officefloor.hq.app.sheet;
 
+import jakarta.persistence.LockModeType;
+import java.util.Optional;
 import org.springframework.data.jpa.repository.JpaRepository;
+import org.springframework.data.jpa.repository.Lock;
+import org.springframework.data.jpa.repository.Query;
+import org.springframework.data.repository.query.Param;
 
 public interface SheetRepository extends JpaRepository<Sheet, String> {
+
+    /** The sheet, locked until the transaction ends, so changes to it are made one at a time. */
+    @Lock(LockModeType.PESSIMISTIC_WRITE)
+    @Query("select s from Sheet s where s.id = :id")
+    Optional<Sheet> findLockedById(@Param("id") String id);
 }
diff --git a/src/main/resources/db/migration/V8__claim_number.sql b/src/main/resources/db/migration/V8__claim_number.sql
new file mode 100644
index 000000000..65e262239
--- /dev/null
+++ b/src/main/resources/db/migration/V8__claim_number.sql
@@ -0,0 +1,5 @@
+-- A claim's number: given when it is opened, the next on its sheet (1, 2, ...), never reused. A
+-- draft has none and voiding clears it. The sheet keeps the last number it gave out.
+ALTER TABLE sheet ADD COLUMN last_claim_number INT DEFAULT 0 NOT NULL;
+ALTER TABLE claim ADD COLUMN claim_number INT;
+ALTER TABLE claim ADD CONSTRAINT claim_number_unique UNIQUE (sheet_id, claim_number);
