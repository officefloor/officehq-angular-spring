         sheet.setToday(today);
         return sheet;
     }
+
+    /** The sheet's next claim number: 1 for the first, then 2, and so on, never given twice. */
+    @Transactional
+    public int nextClaimNumber(String id) {
+        return sheets.findForUpdateById(id).orElseThrow(SheetNotFoundException::new).nextClaimNumber();
+    }
 }
diff --git a/src/main/resources/db/migration/V8__claim_number.sql b/src/main/resources/db/migration/V8__claim_number.sql
new file mode 100644
index 000000000..579ccf885
--- /dev/null
+++ b/src/main/resources/db/migration/V8__claim_number.sql
@@ -0,0 +1,5 @@
+-- A claim's number: given when it is opened, the next on its sheet (1, 2, ...), no gaps and never
+-- reused. A draft has none; voiding a claim clears it. The sheet keeps the last number it gave.
+ALTER TABLE sheet ADD COLUMN last_claim_number INT DEFAULT 0 NOT NULL;
+ALTER TABLE claim ADD COLUMN claim_number INT;
+CREATE UNIQUE INDEX claim_sheet_number ON claim (sheet_id, claim_number);
