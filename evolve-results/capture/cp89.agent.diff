diff --git a/src/main/java/net/officefloor/hq/app/claim/ClaimTag.java b/src/main/java/net/officefloor/hq/app/claim/ClaimTag.java
new file mode 100644
index 000000000..9f23159e1
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/ClaimTag.java
@@ -0,0 +1,33 @@
+package net.officefloor.hq.app.claim;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Entity;
+import jakarta.persistence.GeneratedValue;
+import jakarta.persistence.GenerationType;
+import jakarta.persistence.Id;
+import jakarta.persistence.Table;
+
+/** A tag used on a claim of a sheet, each at most once; it stays once used, so the sheet keeps its due-total. */
+@Entity
+@Table(name = "claim_tag")
+public class ClaimTag {
+
+    @Id
+    @GeneratedValue(strategy = GenerationType.IDENTITY)
+    private Long id;
+
+    @Column(name = "sheet_id", nullable = false)
+    private String sheetId;
+
+    @Column(name = "tag", nullable = false, length = 200)
+    private String tag;
+
+    protected ClaimTag() {}
+
+    public ClaimTag(String sheetId, String tag) {
+        this.sheetId = sheetId;
+        this.tag = tag;
+    }
+
+    public String getTag() { return tag; }
+}
