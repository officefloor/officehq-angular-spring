+        this.sheetId = sheetId;
+        this.tag = tag;
+    }
+
+    public Long getId() {
+        return id;
+    }
+
+    public String getSheetId() {
+        return sheetId;
+    }
+
+    public String getTag() {
+        return tag;
+    }
+}
