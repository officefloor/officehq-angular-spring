         rate.setPct(percent);
         Rate saved = rates.saveAndFlush(rate);
         audit.recordOnCommit("RATE_SET sheet=" + sheetId + " by=" + user
-                + " grade=" + saved.getGrade() + " rate=" + saved.getPct().toPlainString());
+                + " grade=" + saved.getGrade() + " rate=" + saved.getPct().toPlainString()
+                + (saved.getFromDate() != null ? " from=" + saved.getFromDate() : ""));
         return saved;
     }
 }
