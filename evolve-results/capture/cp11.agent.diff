+/** A from-date as a rate takes it: yyyy-mm-dd. */
+export const FROM_DATE = /^\d{4}-\d{2}-\d{2}$/;
+
+/**
+ * The rate a grade has in force on a date (yyyy-mm-dd): of its rates with no from-date or one on or
