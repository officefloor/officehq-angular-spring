+export function rateOn(rates: Rate[], date: string): string | null {
+  let best: Rate | null = null;
+  for (const r of rates) {
+    if (r.from !== null && r.from > date) continue;
+    if (best === null || (best.from ?? '') < (r.from ?? '')) best = r;
+  }
+  return best?.rate ?? null;
