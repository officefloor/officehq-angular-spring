diff --git a/src/main/resources/db/migration/V81__plan_day_of_month.sql b/src/main/resources/db/migration/V81__plan_day_of_month.sql
new file mode 100644
index 000000000..bbef8fffd
--- /dev/null
+++ b/src/main/resources/db/migration/V81__plan_day_of_month.sql
@@ -0,0 +1,4 @@
+-- A plan runs either every so many days (every_days) or monthly on a day of the month (day_of_month,
+-- 1 to 31): exactly one of the two is set.
+ALTER TABLE plan ALTER COLUMN every_days SET NULL;
+ALTER TABLE plan ADD COLUMN day_of_month INT;
