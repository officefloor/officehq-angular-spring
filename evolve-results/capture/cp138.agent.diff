+      const saved = await firstValueFrom(this.http.put<Person>(url, body, this.session.headers()));
+      if (this.session.sheet() === sheet) {
+        this.people.update((list) => list.map((p) => (p.id === saved.id ? saved : p)));
+        this.inlineGrades.update((grades) =>
