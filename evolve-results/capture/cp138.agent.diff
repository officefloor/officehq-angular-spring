+  /** Save the grade chosen on the row from the sheet's today, as an edit in the person form would. */
+  protected saveInlineGrade(p: PersonView, grade: string): void {
+    if (this.inlineGrading() === p.id) return;
+    this.personError.set(null);
+    this.patronError.set(null);
+    const sheet = this.sheets.current();
+    if (!sheet) return;
+    this.inlineGrading.set(p.id);
+    this.api.update(sheet.id, p.id, p.version, { name: p.name, grade: grade as Grade, gradeFrom: null, terms: p.terms,
+      contact: p.contact ?? '', tags: p.tags.join(', ') }).subscribe({
+      next: (saved) => {
+        this.inlineGrading.set(null);
+        this.people.update((list) => list.map((q) => (q.id === saved.id ? saved : q)));
+      },
+      error: () => {
+        this.inlineGrading.set(null);
+        this.personError.set({ id: p.id, message: 'Could not save the grade of ' + p.name + '.' });
+      },
+    });
+  }
