+import jakarta.persistence.GenerationType;
+import jakarta.persistence.Id;
+import jakarta.persistence.Table;
+
+/** A reason on a sheet's list of void reasons: while the list has any, a claim is voided with one. */
+@Entity
+@Table(name = "void_reason")
+public class VoidReason {
+
+    @Id
+    @GeneratedValue(strategy = GenerationType.IDENTITY)
+    private Long id;
+
+    @Column(name = "sheet_id", nullable = false)
+    private String sheetId;
+
+    @Column(name = "reason", nullable = false)
+    private String reason;
+
+    protected VoidReason() {
+    }
+
+    public VoidReason(String sheetId, String reason) {
+        this.sheetId = sheetId;
+        this.reason = reason;
+    }
+
+    public Long getId() {
+        return id;
+    }
+
+    public String getSheetId() {
+        return sheetId;
+    }
+
+    public String getReason() {
+        return reason;
+    }
+}
