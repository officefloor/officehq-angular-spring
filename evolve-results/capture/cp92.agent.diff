diff --git a/src/main/resources/db/migration/V59__claim_edited_by.sql b/src/main/resources/db/migration/V59__claim_edited_by.sql
new file mode 100644
index 000000000..edcf4ac1d
--- /dev/null
+++ b/src/main/resources/db/migration/V59__claim_edited_by.sql
@@ -0,0 +1,3 @@
+-- Who last edited a claim: the signed-in user who last saved its form or its amount entry; null for
+-- a claim never edited. Like its opener, that user may not settle or approve it.
+ALTER TABLE claim ADD COLUMN edited_by VARCHAR(200);
