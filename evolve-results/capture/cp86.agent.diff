+      this.rowError.set({
+        id: claim.id,
+        message: forbidden
+          ? 'The amount could not be saved: your role may not change this sheet.'
+          : 'The amount could not be saved: only a draft outside a closed period can be edited, and not while another user is editing it.',
+      });
+    }
+  }
