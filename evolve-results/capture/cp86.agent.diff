+    /** Lift is blend times the drag's multiplier: L0 0, L1 1, L2 2, L3 3; absent with blend. */
+    public Integer getLift() {
+        Integer blend = getBlend();
+        if (blend == null) {
+            return null;
+        }
+        int multiplier = switch (getDrag()) {
+            case "L3" -> 3;
+            case "L2" -> 2;
+            case "L1" -> 1;
+            default -> 0;
+        };
+        return blend * multiplier;
+    }
