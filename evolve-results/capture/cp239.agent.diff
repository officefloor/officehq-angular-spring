+/** Per period id, how many of the people's claims are due by a date in it, VOID and DELETED claims left out. */
+export function periodClaimCounts(periods: Period[], people: PersonWithClaims[]): Record<number, number> {
+  const counts: Record<number, number> = {};
+  for (const p of periods) counts[p.id] = 0;
+  for (const person of people) {
+    for (const c of person.claims) {
+      if (c.status === 'VOID' || c.status === 'DELETED') continue;
+      const period = periodOf(periods, c.dueBy);
+      if (period) counts[period.id] += 1;
+    }
+  }
+  return counts;
+}
