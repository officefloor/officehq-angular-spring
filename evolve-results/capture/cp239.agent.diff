+/** Each period's count of the claims due by a date in it, by period id, VOID and DELETED claims left out. */
+export function periodClaimCounts(periods: readonly PeriodView[], figures: readonly DatedFigure[]): Map<number, number> {
+  const counts = new Map<number, number>(periods.map((p) => [p.id, 0]));
+  for (const f of figures) {
+    if (f.status === 'VOID' || f.status === 'DELETED') continue;
+    const p = periodOn(periods, f.dueBy);
+    if (p) counts.set(p.id, (counts.get(p.id) ?? 0) + 1);
+  }
+  return counts;
+}
