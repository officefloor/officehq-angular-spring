diff --git a/src/main/java/net/officefloor/hq/app/claim/RemindRefusedException.java b/src/main/java/net/officefloor/hq/app/claim/RemindRefusedException.java
new file mode 100644
index 000000000..fd5fa05ad
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/RemindRefusedException.java
@@ -0,0 +1,9 @@
+package net.officefloor.hq.app.claim;
+
+/** A claim that cannot be reminded: it is not OPEN or PENDING, or was already reminded on the sheet's today. */
+public class RemindRefusedException extends RuntimeException {
+
+    public RemindRefusedException(String message) {
+        super(message);
+    }
+}
