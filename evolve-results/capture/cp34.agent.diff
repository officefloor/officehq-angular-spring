+  protected claimSelected(id: number, selected: boolean): void {
+    this.bulkOpenError.set(null);
+    this.selectedClaims.update((ids) => {
+      const next = new Set(ids);
+      if (selected) next.add(id);
+      else next.delete(id);
+      return next;
+    });
