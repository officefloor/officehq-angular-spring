+  /**
+   * Downloads the person's statement as a CSV file: each claim of theirs bound by their last statement, oldest
+   * first, with the bound figure as the claim shows it.
+   */
+  protected async exportStatement(p: Person): Promise<void> {
+    await this.session.settled();
+    const rates = this.rates.byClaim();
+    const floor = this.settings.floor();
+    const late = this.settings.lateness();
+    const lines = [['number', 'date', 'amount', 'figure', 'status']];
+    for (const c of [...(this.claimsBy().get(p.id) ?? [])].reverse()) {
+      if (!isBound(c)) continue;
+      const figure = dueOf(c, rates(c).get(gradeOn(p.grades, c.date)) ?? [], floor, late, graceOf(c, p.grades, late));
+      lines.push([c.number ?? '', c.date, c.amount, figure ?? 'n/a', c.status]);
+    }
+    this.downloadCsv(`statement-${p.name}.csv`, lines);
+  }
+
   private downloadCsv(fileName: string, lines: string[][]): void {
     const csv = lines.map((fields) => fields.map(csvField).join(',') + '\n').join('');
     const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
