+  protected async exportStatement(p: Person): Promise<void> {
+    if (!(await this.reloadForExport())) return;
+    const theirs = this.claimsOf(p.id);
+    const pctOn = this.pctOnOf(p.id);
+    const graceOn = this.graceOnOf(p.id);
+    const lines = [['number', 'date', 'amount', 'figure', 'status']];
+    for (const c of [...theirs].reverse().filter(isBound)) {
+      const due = claimDueCents(c, pctOn, this.session.floorCentsOn, this.session.late(), roundsOn(c, theirs), graceOn);
+      lines.push([c.number ?? '', c.date, c.amount, due === null ? NA : money(due), c.status]);
+    }
+    downloadCsv(lines, `statement-${p.name}.csv`);
+  }
