diff --git a/src/main/resources/db/migration/V72__statement_cancelled_on.sql b/src/main/resources/db/migration/V72__statement_cancelled_on.sql
new file mode 100644
index 000000000..dfee79c00
--- /dev/null
+++ b/src/main/resources/db/migration/V72__statement_cancelled_on.sql
@@ -0,0 +1,3 @@
+-- The sheet's today when a statement was cancelled (null: it stands). A cancelled statement is kept
+-- so the sheet as it stood before the cancel still shows it.
+ALTER TABLE statement ADD COLUMN cancelled_on DATE;
