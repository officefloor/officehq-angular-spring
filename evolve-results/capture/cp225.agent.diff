+    e.preventDefault();
+    if (this.merging()) return; // a second submit before the first has answered
+    this.error.set(null);
+    this.mergeError.set(null);
+    this.merged.set('');
+    this.merging.set(true);
+    const from = this.mergeFrom();
+    const into = this.mergeInto();
