diff --git a/src/main/resources/db/migration/V4__person_name_unique.sql b/src/main/resources/db/migration/V4__person_name_unique.sql
new file mode 100644
index 000000000..583e551c1
--- /dev/null
+++ b/src/main/resources/db/migration/V4__person_name_unique.sql
@@ -0,0 +1,7 @@
+-- A person's name is unique on the sheet, compared without case and ignoring surrounding spaces.
+-- Names are stored trimmed; name_key is the trimmed, lower-cased name the uniqueness is kept on.
+UPDATE person SET name = TRIM(name);
+ALTER TABLE person ADD COLUMN name_key VARCHAR(200);
+UPDATE person SET name_key = LOWER(name);
+ALTER TABLE person ALTER COLUMN name_key SET NOT NULL;
+CREATE UNIQUE INDEX person_sheet_name ON person (sheet_id, name_key);
