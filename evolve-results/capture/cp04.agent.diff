diff --git a/src/main/java/net/officefloor/hq/app/person/PersonService.java b/src/main/java/net/officefloor/hq/app/person/PersonService.java
index cf97b38ad..f2d294883 100644
--- a/src/main/java/net/officefloor/hq/app/person/PersonService.java
+++ b/src/main/java/net/officefloor/hq/app/person/PersonService.java
@@ -2,6 +2,7 @@ package net.officefloor.hq.app.person;
 
 import java.util.List;
 import net.officefloor.hq.app.sheet.SheetService;
+import org.springframework.dao.DataIntegrityViolationException;
 import org.springframework.http.HttpStatus;
 import org.springframework.stereotype.Service;
 import org.springframework.transaction.annotation.Transactional;
@@ -27,15 +28,41 @@ public class PersonService {
     @Transactional
     public Person add(String sheetId, String user, String name, String grade) {
         sheets.load(sheetId, user);
-        return people.save(new Person(sheetId, name, grade));
+        String trimmed = name.trim();
+        requireUnusedName(sheetId, null, trimmed);
+        try {
+            return people.saveAndFlush(new Person(sheetId, trimmed, grade));
+        } catch (DataIntegrityViolationException e) {
+            throw nameInUse(); // added by another user at the same moment
+        }
     }
 
     @Transactional
     public Person update(String sheetId, long id, String name, String grade) {
         Person person = people.findByIdAndSheetId(id, sheetId)
                 .orElseThrow(() -> new ResponseStatusException(HttpStatus.NOT_FOUND, "No such person"));
-        person.setName(name);
+        String trimmed = name.trim();
+        requireUnusedName(sheetId, id, trimmed);
+        person.setName(trimmed);
         person.setGrade(grade);
+        try {
+            people.flush();
+        } catch (DataIntegrityViolationException e) {
+            throw nameInUse(); // taken by another user at the same moment
+        }
         return person;
     }
+
+    /** Refuse a name another person on the sheet already has (ignoring case). */
+    private void requireUnusedName(String sheetId, Long exceptId, String name) {
+        boolean taken = people.findBySheetIdAndNameIgnoreCase(sheetId, name).stream()
+                .anyMatch(p -> !p.getId().equals(exceptId));
+        if (taken) {
+            throw nameInUse();
+        }
+    }
+
+    private static ResponseStatusException nameInUse() {
+        return new ResponseStatusException(HttpStatus.CONFLICT, "Name already in use");
+    }
 }
diff --git a/src/main/resources/db/migration/V4__person_name_unique.sql b/src/main/resources/db/migration/V4__person_name_unique.sql
new file mode 100644
index 000000000..2a929ea88
--- /dev/null
+++ b/src/main/resources/db/migration/V4__person_name_unique.sql
@@ -0,0 +1,5 @@
+-- A person's name is unique on its sheet, ignoring case and surrounding spaces. Names are kept
+-- trimmed; name_key is the lower-cased name the uniqueness is enforced on.
+UPDATE person SET name = TRIM(name);
+ALTER TABLE person ADD COLUMN name_key VARCHAR(200) GENERATED ALWAYS AS (LOWER(name));
+CREATE UNIQUE INDEX person_sheet_name ON person (sheet_id, name_key);
