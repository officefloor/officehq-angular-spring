diff --git a/src/main/resources/db/migration/V4__person_unique_name.sql b/src/main/resources/db/migration/V4__person_unique_name.sql
new file mode 100644
index 00000000..8e48aced
--- /dev/null
+++ b/src/main/resources/db/migration/V4__person_unique_name.sql
@@ -0,0 +1,5 @@
+-- A person's name is unique on the sheet, compared without regard to case. Names are kept with
+-- surrounding spaces removed.
+UPDATE person SET name = TRIM(name);
+ALTER TABLE person ADD COLUMN name_key VARCHAR(200) GENERATED ALWAYS AS (LOWER(name));
+CREATE UNIQUE INDEX person_sheet_name ON person (sheet_id, name_key);
