diff --git a/src/main/resources/db/migration/V38__sheet_permission.sql b/src/main/resources/db/migration/V38__sheet_permission.sql
new file mode 100644
index 000000000..80b24d5fc
--- /dev/null
+++ b/src/main/resources/db/migration/V38__sheet_permission.sql
@@ -0,0 +1,9 @@
+-- The sheet's permission matrix: for an action (open, settle, void, reassign, close, reopen), the
+-- roles that may take it, comma separated. An action with no row keeps the standing rule: open,
+-- settle, void and close by clerk and steward; reassign and reopen by steward. Not dated.
+CREATE TABLE sheet_permission (
+    sheet_id VARCHAR(100) NOT NULL REFERENCES sheet (id),
+    action   VARCHAR(20)  NOT NULL,
+    roles    VARCHAR(200) NOT NULL,
+    PRIMARY KEY (sheet_id, action)
+);
