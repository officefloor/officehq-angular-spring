diff --git a/src/main/resources/db/migration/V38__sheet_permission.sql b/src/main/resources/db/migration/V38__sheet_permission.sql
new file mode 100644
index 000000000..2ce447419
--- /dev/null
+++ b/src/main/resources/db/migration/V38__sheet_permission.sql
@@ -0,0 +1,9 @@
+-- The permission matrix: for an action (open, settle, void, reassign, close, reopen), the roles that may take it, as
+-- a comma separated list (clerk, steward). Not dated. An action with no row keeps the standing rule: open, settle,
+-- void and close by clerk and steward; reassign and reopen by steward.
+CREATE TABLE sheet_permission (
+    sheet_id VARCHAR(100) NOT NULL REFERENCES sheet (id),
+    action   VARCHAR(20)  NOT NULL,
+    roles    VARCHAR(100) NOT NULL,
+    PRIMARY KEY (sheet_id, action)
+);
