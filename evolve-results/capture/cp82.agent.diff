+  private readonly splitByPerson = computed(() => {
+    const dueTerms = this.sheets.current() ?? DEFAULT_DUE_TERMS;
+    const byPerson = new Map<number, Split>();
+    for (const p of this.people()) {
+      const split = { ...NO_SPLIT };
