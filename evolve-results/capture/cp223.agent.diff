diff --git a/src/main/resources/db/migration/V117__grade_retired.sql b/src/main/resources/db/migration/V117__grade_retired.sql
new file mode 100644
index 000000000..080b17ec3
--- /dev/null
+++ b/src/main/resources/db/migration/V117__grade_retired.sql
@@ -0,0 +1,7 @@
+-- The grades retired on a sheet: a retired grade cannot be given to a new person nor chosen in an edit; people
+-- already on it keep it. Not dated.
+CREATE TABLE sheet_grade_retired (
+    sheet_id VARCHAR(100) NOT NULL REFERENCES sheet (id),
+    grade    VARCHAR(1)   NOT NULL,
+    PRIMARY KEY (sheet_id, grade)
+);
