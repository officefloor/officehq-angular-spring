+    public Sheet previewedOn(LocalDate date) {
+        Sheet copy = copyTo(id, createdBy, createdAt);
+        copy.today = date;
+        copy.clonedFrom = clonedFrom;
+        copy.lastClaimNumber = lastClaimNumber;
+        copy.archived = archived;
+        return copy;
+    }
