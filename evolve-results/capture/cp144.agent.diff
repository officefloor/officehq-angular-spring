diff --git a/src/main/resources/db/migration/V79__fiscal_claim_number.sql b/src/main/resources/db/migration/V79__fiscal_claim_number.sql
new file mode 100644
index 00000000..2bd4c1f0
--- /dev/null
+++ b/src/main/resources/db/migration/V79__fiscal_claim_number.sql
@@ -0,0 +1,7 @@
+-- The last claim number a sheet gave in a fiscal year (FY<year>); a sheet's tree counts one sequence per fiscal year.
+CREATE TABLE sheet_fiscal_claim_number (
+    sheet_id VARCHAR(100) NOT NULL,
+    fiscal_year INTEGER NOT NULL,
+    last_claim_number BIGINT NOT NULL,
+    PRIMARY KEY (sheet_id, fiscal_year)
+);
