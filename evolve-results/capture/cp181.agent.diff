diff --git a/src/main/java/net/officefloor/hq/app/invoices/PaymentMatch.java b/src/main/java/net/officefloor/hq/app/invoices/PaymentMatch.java
new file mode 100644
index 0000000..3bf4641
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/invoices/PaymentMatch.java
@@ -0,0 +1,32 @@
+package net.officefloor.hq.app.invoices;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Embeddable;
+import java.math.BigDecimal;
+
+/** An invoice whose purchase order number one part of a payment's remittance matched, and how closely. */
+@Embeddable
+public class PaymentMatch {
+
+    @Column(name = "invoice_id")
+    private Long invoiceId;
+
+    /** The Jaro-Winkler similarity, to three decimals. */
+    private BigDecimal score;
+
+    protected PaymentMatch() {
+    }
+
+    public PaymentMatch(Long invoiceId, BigDecimal score) {
+        this.invoiceId = invoiceId;
+        this.score = score;
+    }
+
+    public Long getInvoiceId() {
+        return invoiceId;
+    }
+
+    public BigDecimal getScore() {
+        return score;
+    }
+}
diff --git a/src/main/resources/db/migration/V82__payment_matches.sql b/src/main/resources/db/migration/V82__payment_matches.sql
new file mode 100644
index 0000000..1d75d56
--- /dev/null
+++ b/src/main/resources/db/migration/V82__payment_matches.sql
@@ -0,0 +1,13 @@
+-- Each part of a payment's remittance (separated by semicolons) may match an invoice's purchase order number:
+-- the invoices matched, in the order of the parts, and how closely (Jaro-Winkler).
+CREATE TABLE payment_match (
+    payment_id BIGINT       NOT NULL REFERENCES payment (id) ON DELETE CASCADE,
+    position   INT          NOT NULL,
+    invoice_id BIGINT       NOT NULL REFERENCES invoice (id) ON DELETE CASCADE,
+    score      DECIMAL(4, 3) NOT NULL,
+    PRIMARY KEY (payment_id, position)
+);
+INSERT INTO payment_match (payment_id, position, invoice_id, score)
+    SELECT id, 0, matched_invoice, match_score FROM payment WHERE matched_invoice IS NOT NULL;
+ALTER TABLE payment DROP COLUMN matched_invoice;
+ALTER TABLE payment DROP COLUMN match_score;
