+package net.officefloor.hq.app.note;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Entity;
+import jakarta.persistence.GeneratedValue;
+import jakarta.persistence.GenerationType;
+import jakarta.persistence.Id;
+import jakarta.persistence.Table;
+import java.time.LocalDate;
+
+/** A note on a sheet: a text a user added, dated by the sheet's today when it was added. */
+@Entity
+@Table(name = "sheet_note")
+public class SheetNote {
+
+    @Id
+    @GeneratedValue(strategy = GenerationType.IDENTITY)
+    private Long id;
+
+    @Column(name = "sheet_id", nullable = false)
+    private String sheetId;
+
+    @Column(name = "added_on", nullable = false)
+    private LocalDate addedOn;
+
+    @Column(name = "added_by", nullable = false)
+    private String addedBy;
+
+    @Column(name = "note_text", nullable = false)
+    private String text;
+
+    protected SheetNote() {
+    }
+
+    public SheetNote(String sheetId, LocalDate addedOn, String addedBy, String text) {
+        this.sheetId = sheetId;
+        this.addedOn = addedOn;
+        this.addedBy = addedBy;
+        this.text = text;
+    }
+
+    public Long getId() {
+        return id;
+    }
+
+    public String getSheetId() {
+        return sheetId;
+    }
+
+    public LocalDate getAddedOn() {
+        return addedOn;
+    }
+
+    public String getAddedBy() {
+        return addedBy;
+    }
+
+    public String getText() {
+        return text;
+    }
+}
