diff --git a/src/main/resources/db/migration/V90__rate_forward_only.sql b/src/main/resources/db/migration/V90__rate_forward_only.sql
new file mode 100644
index 000000000..63c957fdf
--- /dev/null
+++ b/src/main/resources/db/migration/V90__rate_forward_only.sql
@@ -0,0 +1,8 @@
+-- A rate saved with a from-date on or after the sheet's today is forward-only: it applies only to
+-- claims added after it was saved. forward_after is the id of the newest claim there was when it was
+-- saved (claims are numbered in the order they are added); a claim with that id or a lower one keeps
+-- the rates that applied to it. Null: the rate applies to every claim. Kept for each version of a
+-- rate and in its history, as each version was saved.
+ALTER TABLE rate ADD COLUMN forward_after BIGINT;
+ALTER TABLE rate_version ADD COLUMN forward_after BIGINT;
+ALTER TABLE rate_history ADD COLUMN forward_after BIGINT;
diff --git a/src/main/resources/db/migration/V91__person_snapshot_made_on.sql b/src/main/resources/db/migration/V91__person_snapshot_made_on.sql
new file mode 100644
index 000000000..6ff3b387f
--- /dev/null
+++ b/src/main/resources/db/migration/V91__person_snapshot_made_on.sql
@@ -0,0 +1,3 @@
+-- A SNAPSHOT is written as the sheet's today moves to another day: made_on is that day, the one the
+-- snapshot first stood on (null for one written before it was kept: taken as the day after its own).
+ALTER TABLE person_snapshot ADD COLUMN made_on DATE;
