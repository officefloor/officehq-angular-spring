+export function ratesForClaim(rates: readonly Rate[], added: number): Rate[] {
+  const out: Rate[] = [];
+  for (const r of rates) {
+    if (r.afterClaim == null || added > r.afterClaim) {
+      out.push(r);
+      continue;
+    }
+    const e = (r.earlier ?? []).find((v) => v.afterClaim === null || added > v.afterClaim);
