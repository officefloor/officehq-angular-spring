+-- A steward delegating the steward role to a user name for a from-date to a to-date, inclusive, by
+-- the sheet's today. While the sheet's today is inside the range the user acts as a steward.
+CREATE TABLE delegation (
+    id           BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id     VARCHAR(100) NOT NULL REFERENCES sheet (id),
+    user_name    VARCHAR(100) NOT NULL,
+    delegated_by VARCHAR(100) NOT NULL,
+    from_date    DATE         NOT NULL,
+    to_date      DATE         NOT NULL,
+    CHECK (to_date >= from_date)
+);
+CREATE INDEX delegation_sheet_user ON delegation (sheet_id, user_name);
