diff --git a/src/main/java/net/officefloor/hq/app/rate/RateLog.java b/src/main/java/net/officefloor/hq/app/rate/RateLog.java
new file mode 100644
index 000000000..d7bdf583a
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/rate/RateLog.java
@@ -0,0 +1,78 @@
+package net.officefloor.hq.app.rate;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Entity;
+import jakarta.persistence.GeneratedValue;
+import jakarta.persistence.GenerationType;
+import jakarta.persistence.Id;
+import jakarta.persistence.Table;
+import java.math.BigDecimal;
+import java.time.LocalDate;
+
+/**
+ * One rate as it was set: the grade, its from-date and to-date, the percent, and the sheet's today
+ * when it was set (none: from the beginning of time). Kept so the rates can be rebuilt as they stood
+ * at the end of a day.
+ */
+@Entity
+@Table(name = "rate_log")
+public class RateLog {
+
+    @Id
+    @GeneratedValue(strategy = GenerationType.IDENTITY)
+    private Long id;
+
+    @Column(name = "sheet_id", nullable = false)
+    private String sheetId;
+
+    @Column(name = "grade", nullable = false)
+    private String grade;
+
+    @Column(name = "from_date")
+    private LocalDate fromDate;
+
+    @Column(name = "to_date")
+    private LocalDate toDate;
+
+    @Column(name = "pct", nullable = false, precision = 5, scale = 2)
+    private BigDecimal pct;
+
+    @Column(name = "made_on")
+    private LocalDate madeOn;
+
+    protected RateLog() {
+    }
+
+    public RateLog(Rate rate, LocalDate madeOn) {
+        this.sheetId = rate.getSheetId();
+        this.grade = rate.getGrade();
+        this.fromDate = rate.getFromDate();
+        this.toDate = rate.getToDate();
+        this.pct = rate.getPct();
+        this.madeOn = madeOn;
+    }
+
+    public Long getId() {
+        return id;
+    }
+
+    /** Whether it was set by the end of a day: the sheet's today then on or before it. */
+    public boolean madeBy(LocalDate day) {
+        return madeOn == null || !madeOn.isAfter(day);
+    }
+
+    /** The rate as it was set, not to be saved. */
+    public Rate toRate() {
+        Rate rate = new Rate(sheetId, grade, fromDate, pct);
+        rate.setToDate(toDate);
+        return rate;
+    }
+
+    public String getGrade() {
+        return grade;
+    }
+
+    public LocalDate getFromDate() {
+        return fromDate;
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/rate/RateLogRepository.java b/src/main/java/net/officefloor/hq/app/rate/RateLogRepository.java
new file mode 100644
index 000000000..d7288da95
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/rate/RateLogRepository.java
@@ -0,0 +1,29 @@
+package net.officefloor.hq.app.rate;
+
+import java.time.LocalDate;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import org.springframework.data.jpa.repository.JpaRepository;
+
+public interface RateLogRepository extends JpaRepository<RateLog, Long> {
+
+    /** A sheet's rates as set, oldest first. */
+    List<RateLog> findBySheetIdOrderByIdAsc(String sheetId);
+
+    /**
+     * The sheet's rates as they stood at the end of a day: each set while the sheet's today was on
+     * or before it, a later one for the same grade and from-date replacing an earlier. Not to be saved.
+     */
+    default List<Rate> asOf(String sheetId, LocalDate day) {
+        Map<List<Object>, Rate> by = new LinkedHashMap<>();
+        for (RateLog set : findBySheetIdOrderByIdAsc(sheetId)) {
+            if (set.madeBy(day)) {
+                by.put(Arrays.asList(set.getGrade(), set.getFromDate()), set.toRate());
+            }
+        }
+        return new ArrayList<>(by.values());
+    }
+}
