+export const FISCAL_YEAR = /^\d{4}$/;
+
+/**
+ * The name of the fiscal year a date (yyyy-mm-dd) falls in, FY<yyyy> by the calendar year its first
+ * day falls in, for a fiscal year starting on the first of a month (1 to 12).
