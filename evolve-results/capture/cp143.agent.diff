+        Sheet sheet = lock(id);
+        sheet.setFiscalStartMonth(month);
+        Sheet saved = sheets.saveAndFlush(sheet);
+        audit.recordOnCommit("SETTING_CHANGED sheet=" + id + " by=" + user + " key=fiscal-start-month value="
+                + saved.getFiscalStartMonth());
+        return saved;
