 package net.officefloor.hq.app.rate;
 
+import java.time.LocalDate;
+import java.util.List;
+import java.util.Objects;
+import java.util.Optional;
 import org.springframework.data.jpa.repository.JpaRepository;
 
 public interface RateVersionRepository extends JpaRepository<RateVersion, Long> {
+
+    /** A grade's older versions on a sheet, newest first. */
+    List<RateVersion> findBySheetIdAndGradeOrderByVersionDesc(String sheetId, String grade);
+
+    /** The newest older version of the grade's rate from a from-date (or its undated rate when null). */
+    default Optional<RateVersion> findNewest(String sheetId, String grade, LocalDate fromDate) {
+        return findBySheetIdAndGradeOrderByVersionDesc(sheetId, grade).stream()
+                .filter(v -> Objects.equals(v.getFromDate(), fromDate)).findFirst();
+    }
 }
diff --git a/src/main/resources/db/migration/V125__rate_withdraw.sql b/src/main/resources/db/migration/V125__rate_withdraw.sql
new file mode 100644
index 000000000..4e3a5dafa
--- /dev/null
+++ b/src/main/resources/db/migration/V125__rate_withdraw.sql
@@ -0,0 +1,5 @@
+-- A steward can withdraw a rate's newest version: the version before it applies again (or, with
+-- none, the rate is gone). An older version keeps whether it was forward-only so it can be put back,
+-- and the rate log records each withdrawal so the rates can still be rebuilt as of a day.
+ALTER TABLE rate_version ADD COLUMN forward_after BIGINT;
+ALTER TABLE rate_log ADD COLUMN withdrawn BOOLEAN DEFAULT FALSE NOT NULL;
