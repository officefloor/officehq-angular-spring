+      this.withdrawn.emit(result);
+    } catch {
+      if (this.session.sheetId() !== sheet) return;
+      this.error.set('That rate could not be withdrawn: only a steward can withdraw a rate.');
+    } finally {
+      this.withdrawing = false;
+    }
