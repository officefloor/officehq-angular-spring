diff --git a/src/main/resources/db/migration/V2__sheet_today.sql b/src/main/resources/db/migration/V2__sheet_today.sql
new file mode 100644
index 00000000..45fbcc40
--- /dev/null
+++ b/src/main/resources/db/migration/V2__sheet_today.sql
@@ -0,0 +1,5 @@
+-- Each sheet keeps its own "today": every date-dependent decision and default date uses it, never
+-- the real clock. It starts as the real date when the sheet is first loaded.
+ALTER TABLE sheet ADD COLUMN today DATE;
+UPDATE sheet SET today = CAST(created_at AS DATE);
+ALTER TABLE sheet ALTER COLUMN today SET NOT NULL;
