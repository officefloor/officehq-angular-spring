diff --git a/src/main/java/net/officefloor/hq/app/ClockConfig.java b/src/main/java/net/officefloor/hq/app/ClockConfig.java
new file mode 100644
index 000000000..78b1d4c56
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/ClockConfig.java
@@ -0,0 +1,18 @@
+package net.officefloor.hq.app;
+
+import java.time.Clock;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+
+/**
+ * The real clock. Only a new sheet's starting "today" reads it: every other date-dependent
+ * decision and default uses the sheet's today (Sheet#getToday), never this clock.
+ */
+@Configuration
+public class ClockConfig {
+
+    @Bean
+    public Clock clock() {
+        return Clock.systemDefaultZone();
+    }
+}
