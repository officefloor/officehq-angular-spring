+  band(p: Person): string {
+    const mid = this.session.scoreMid();
+    const high = this.session.scoreHigh();
+    if (mid === null || high === null) return '';
+    const score = Number(this.score(p));
+    return score >= high ? 'HIGH' : score >= mid ? 'MID' : 'LOW';
