+/** How many people there are, those whose names or aliases match (as names are compared) taken as one. */
+function distinctPeople(people: Person[]): number {
+  const parent = people.map((_, i) => i);
+  const root = (i: number): number => (parent[i] === i ? i : (parent[i] = root(parent[i])));
+  const byKey = new Map<string, number>();
+  people.forEach((p, i) => {
+    for (const n of [p.name, ...(p.aliases ?? [])]) {
+      const key = nameKey(n);
+      const seen = byKey.get(key);
+      if (seen === undefined) byKey.set(key, i);
+      else parent[root(i)] = root(seen);
+    }
+  });
+  return new Set(people.map((_, i) => root(i))).size;
+}
