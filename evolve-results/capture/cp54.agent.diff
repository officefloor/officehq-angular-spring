diff --git a/src/main/java/net/officefloor/hq/app/access/ViewerGuard.java b/src/main/java/net/officefloor/hq/app/access/ViewerGuard.java
new file mode 100644
index 00000000..0b9a2667
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/access/ViewerGuard.java
@@ -0,0 +1,55 @@
+package net.officefloor.hq.app.access;
+
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletResponse;
+import java.util.Map;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.MediaType;
+import org.springframework.stereotype.Component;
+import org.springframework.web.servlet.HandlerInterceptor;
+import org.springframework.web.servlet.HandlerMapping;
+
+/**
+ * Refuses every change a viewer asks for on a sheet (403, writing nothing). Reading, and loading a sheet,
+ * go through; so do the bulk actions, which answer with nothing done and every selected item refused.
+ */
+@Component
+public class ViewerGuard implements HandlerInterceptor {
+
+    private static final String REFUSAL = "{\"message\":\"A viewer can change nothing.\"}";
+
+    private final AccessService access;
+
+    public ViewerGuard(AccessService access) {
+        this.access = access;
+    }
+
+    @Override
+    public boolean preHandle(HttpServletRequest request, HttpServletResponse response, Object handler)
+            throws Exception {
+        if (HttpMethod.GET.matches(request.getMethod()) || HttpMethod.HEAD.matches(request.getMethod())) {
+            return true;
+        }
+        String path = request.getRequestURI();
+        if (path.endsWith("/load") || path.contains("/bulk-")) {
+            return true;
+        }
+        Object vars = request.getAttribute(HandlerMapping.URI_TEMPLATE_VARIABLES_ATTRIBUTE);
+        String user = request.getHeader("X-User");
+        if (!(vars instanceof Map<?, ?> v) || user == null) {
+            return true;
+        }
+        Object sheet = v.containsKey("sheetId") ? v.get("sheetId") : v.get("id");
+        if (!(sheet instanceof String id)) {
+            return true;
+        }
+        if (!access.isViewer(id.trim(), user.trim())) {
+            return true;
+        }
+        response.setStatus(HttpStatus.FORBIDDEN.value());
+        response.setContentType(MediaType.APPLICATION_JSON_VALUE);
+        response.getWriter().write(REFUSAL);
+        return false;
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/access/ViewerGuardConfig.java b/src/main/java/net/officefloor/hq/app/access/ViewerGuardConfig.java
new file mode 100644
index 00000000..a72af4cf
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/access/ViewerGuardConfig.java
@@ -0,0 +1,21 @@
+package net.officefloor.hq.app.access;
+
+import org.springframework.context.annotation.Configuration;
+import org.springframework.web.servlet.config.annotation.InterceptorRegistry;
+import org.springframework.web.servlet.config.annotation.WebMvcConfigurer;
+
+/** Puts the {@link ViewerGuard} in front of every sheet endpoint. */
+@Configuration
+public class ViewerGuardConfig implements WebMvcConfigurer {
+
+    private final ViewerGuard guard;
+
+    public ViewerGuardConfig(ViewerGuard guard) {
+        this.guard = guard;
+    }
+
+    @Override
+    public void addInterceptors(InterceptorRegistry registry) {
+        registry.addInterceptor(guard).addPathPatterns("/api/sheets/**");
+    }
+}
