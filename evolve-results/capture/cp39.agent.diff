diff --git a/src/main/java/net/officefloor/hq/app/claim/StatusLogLine.java b/src/main/java/net/officefloor/hq/app/claim/StatusLogLine.java
new file mode 100644
index 00000000..613a92c7
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/StatusLogLine.java
@@ -0,0 +1,51 @@
+package net.officefloor.hq.app.claim;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Embeddable;
+import jakarta.persistence.EnumType;
+import jakarta.persistence.Enumerated;
+import java.time.LocalDate;
+
+/** One line of a claim's status log: the status it took, who changed it, the sheet's today then, and the claim's
+ * due as computed at that moment, with two decimals ("n/a" when it had none). */
+@Embeddable
+public class StatusLogLine {
+
+    @Enumerated(EnumType.STRING)
+    @Column(name = "status", nullable = false)
+    private ClaimStatus status;
+
+    @Column(name = "by_user", nullable = false)
+    private String by;
+
+    @Column(name = "on_date", nullable = false)
+    private LocalDate on;
+
+    @Column(name = "due", nullable = false)
+    private String due;
+
+    protected StatusLogLine() {}
+
+    public StatusLogLine(ClaimStatus status, String by, LocalDate on, String due) {
+        this.status = status;
+        this.by = by;
+        this.on = on;
+        this.due = due;
+    }
+
+    public ClaimStatus getStatus() {
+        return status;
+    }
+
+    public String getBy() {
+        return by;
+    }
+
+    public LocalDate getOn() {
+        return on;
+    }
+
+    public String getDue() {
+        return due;
+    }
+}
diff --git a/src/main/resources/db/migration/V31__claim_status_log.sql b/src/main/resources/db/migration/V31__claim_status_log.sql
new file mode 100644
index 00000000..53935c80
--- /dev/null
+++ b/src/main/resources/db/migration/V31__claim_status_log.sql
@@ -0,0 +1,12 @@
+-- A claim's status log: one line per status it has had, oldest first, with who made the change, the sheet's
+-- today then, and the claim's due as it was computed at that moment (n/a when it had none). A claim already there
+-- has no log.
+CREATE TABLE claim_status_log (
+    claim_id  BIGINT       NOT NULL REFERENCES claim (id),
+    seq       INT          NOT NULL,
+    status    VARCHAR(20)  NOT NULL,
+    by_user   VARCHAR(255) NOT NULL,
+    on_date   DATE         NOT NULL,
+    due       VARCHAR(20)  NOT NULL,
+    PRIMARY KEY (claim_id, seq)
+);
