diff --git a/src/main/java/net/officefloor/hq/app/claim/StatusChange.java b/src/main/java/net/officefloor/hq/app/claim/StatusChange.java
new file mode 100644
index 000000000..ba8ef5d5f
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/StatusChange.java
@@ -0,0 +1,53 @@
+package net.officefloor.hq.app.claim;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Embeddable;
+import jakarta.persistence.EnumType;
+import jakarta.persistence.Enumerated;
+import java.math.BigDecimal;
+import java.time.LocalDate;
+
+/** A line of a claim's status log: the status it took, who made the change, the sheet's today then, and
+ *  the claim's due as it was computed at that moment (none when it was n/a). */
+@Embeddable
+public class StatusChange {
+
+    @Enumerated(EnumType.STRING)
+    @Column(name = "status", nullable = false)
+    private ClaimStatus status;
+
+    @Column(name = "by_user", nullable = false)
+    private String by;
+
+    @Column(name = "on_date", nullable = false)
+    private LocalDate on;
+
+    @Column(name = "due")
+    private BigDecimal due;
+
+    protected StatusChange() {
+    }
+
+    public StatusChange(ClaimStatus status, String by, LocalDate on, BigDecimal due) {
+        this.status = status;
+        this.by = by;
+        this.on = on;
+        this.due = due;
+    }
+
+    public ClaimStatus getStatus() {
+        return status;
+    }
+
+    public String getBy() {
+        return by;
+    }
+
+    public LocalDate getOn() {
+        return on;
+    }
+
+    public BigDecimal getDue() {
+        return due;
+    }
+}
diff --git a/src/main/resources/db/migration/V31__claim_status_log.sql b/src/main/resources/db/migration/V31__claim_status_log.sql
new file mode 100644
index 000000000..4148ce743
--- /dev/null
+++ b/src/main/resources/db/migration/V31__claim_status_log.sql
@@ -0,0 +1,12 @@
+-- Each claim's status log: one line per status it has had, oldest first, with who made the change, the
+-- sheet's today then, and the claim's due as it was computed at that moment (none when it was n/a).
+-- Existing claims start with no lines.
+CREATE TABLE claim_status_log (
+    claim_id BIGINT       NOT NULL REFERENCES claim (id),
+    seq      INT          NOT NULL,
+    status   VARCHAR(20)  NOT NULL,
+    by_user  VARCHAR(200) NOT NULL,
+    on_date  DATE         NOT NULL,
+    due      DECIMAL(19, 2),
+    PRIMARY KEY (claim_id, seq)
+);
