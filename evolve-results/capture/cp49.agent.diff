+        this.pasting = false;
+        if (this.session.sheetId() !== sheetId) return;
+        for (const c of claims) this.claimSaved(c);
+        this.pasteAdded.set(added);
+        this.pasteForm.reset({ text: '' }, { emitEvent: false });
