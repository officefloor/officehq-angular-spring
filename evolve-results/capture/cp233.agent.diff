+  /** Set a DRAFT, OPEN or PENDING claim's due-by directly (a steward's action): it stays as set, and a
+   *  holiday added later does not move it. An error message when refused. */
+  async setDueBy(id: number, date: string): Promise<string | null> {
+    const sid = this.session.sheetId();
+    const user = this.session.user();
+    if (!user || !sid) return 'Load a sheet first.';
+    if (!isDate(date.trim())) return 'Enter the new due-by as YYYY-MM-DD.';
+    try {
+      const claim = await firstValueFrom(
+        this.http.post<Claim>(
+          `${this.url(sid)}/claims/${id}/due-by`,
+          { dueBy: date.trim() },
+          { headers: { 'X-User': user } },
+        ),
+      );
+      if (this.session.sheetId() === sid) this.claims.update((cs) => cs.map((c) => (c.id === id ? claim : c)));
+      return null;
+    } catch (e) {
+      return failed('set due-by', e);
+    }
+  }
