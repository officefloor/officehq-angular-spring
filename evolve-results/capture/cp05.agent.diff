+    /** Tier classifies momentum: SINK below zero, STEADY up to 99, SURGE from 100; absent with momentum. */
+    public String getTier() {
+        Integer momentum = getMomentum();
+        if (momentum == null) {
+            return null;
+        }
+        return momentum < 0 ? "SINK" : momentum <= 99 ? "STEADY" : "SURGE";
+    }
