diff --git a/src/main/java/net/officefloor/hq/app/claim/DeleteRefusedException.java b/src/main/java/net/officefloor/hq/app/claim/DeleteRefusedException.java
new file mode 100644
index 000000000..c4c39ad54
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/DeleteRefusedException.java
@@ -0,0 +1,10 @@
+package net.officefloor.hq.app.claim;
+
+/** A claim that cannot be deleted or restored: only a DRAFT is deleted, and only a DELETED claim is
+ *  restored, on the sheet's today it was deleted. */
+public class DeleteRefusedException extends RuntimeException {
+
+    public DeleteRefusedException(String message) {
+        super(message);
+    }
+}
