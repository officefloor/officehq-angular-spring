+            throw new PeriodNotStewardException();
+        }
+        if (!period.isClosed()) {
+            throw new PeriodRefusedException("not closed");
+        }
+        period.reopen();
+        periods.flush();
+        audit.change("PERIOD_REOPENED", sheetId, user, "period=" + period.getName());
+        return period;
+    }
