diff --git a/src/main/resources/db/migration/V35__period_person_total.sql b/src/main/resources/db/migration/V35__period_person_total.sql
new file mode 100644
index 00000000..2ec13260
--- /dev/null
+++ b/src/main/resources/db/migration/V35__period_person_total.sql
@@ -0,0 +1,8 @@
+-- Each person's due-total for a closed period, fixed when it closed: the dues of their claims that count dated
+-- in it. A person with none has no line, and shows 0.00. Reopening the period removes its lines.
+CREATE TABLE period_person_total (
+    period_id BIGINT         NOT NULL REFERENCES period (id),
+    person_id BIGINT         NOT NULL REFERENCES person (id),
+    total     DECIMAL(19, 2) NOT NULL,
+    PRIMARY KEY (period_id, person_id)
+);
