+    /** Move a claim to a new status; a change its current status does not allow is refused. */
+    @Transactional
+    public Claim changeStatus(String sheetId, String user, long claimId, ClaimStatus to) {
+        Claim claim = claims.lockByIdAndSheetId(claimId, sheetId)
+                .orElseThrow(() -> new ResponseStatusException(HttpStatus.NOT_FOUND, "No such claim on this sheet"));
+        if (!claim.getStatus().canBecome(to)) {
+            throw new ResponseStatusException(HttpStatus.CONFLICT,
+                    "A " + claim.getStatus() + " claim cannot become " + to);
+        }
+        claim.setStatus(to);
+        Claim saved = claims.saveAndFlush(claim);
+        String event = switch (to) {
+            case OPEN -> "CLAIM_OPENED";
+            case SETTLED -> "CLAIM_SETTLED";
+            case VOID -> "CLAIM_VOIDED";
+            case DRAFT -> throw new IllegalStateException("a claim never returns to DRAFT");
+        };
+        audit.recordOnCommit(record(event, sheetId, user, person(sheetId, saved.getPersonId()), saved));
+        return saved;
+    }
+
     private Person person(String sheetId, long personId) {
         return people.findByIdAndSheetId(personId, sheetId)
                 .orElseThrow(() -> new ResponseStatusException(HttpStatus.NOT_FOUND, "No such person on this sheet"));
diff --git a/src/main/java/net/officefloor/hq/app/claim/ClaimStatus.java b/src/main/java/net/officefloor/hq/app/claim/ClaimStatus.java
new file mode 100644
index 000000000..2afcfce05
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/ClaimStatus.java
@@ -0,0 +1,22 @@
+package net.officefloor.hq.app.claim;
+
+/** Where a claim is in its life: it starts as a draft, is opened and then settled; a draft or an
+ *  open claim may be voided. A settled or voided claim cannot change status. */
+public enum ClaimStatus {
+    DRAFT, OPEN, SETTLED, VOID;
+
+    /** Whether a claim at this status may move to {@code to}. */
+    public boolean canBecome(ClaimStatus to) {
+        return switch (to) {
+            case OPEN -> this == DRAFT;
+            case SETTLED -> this == OPEN;
+            case VOID -> this == DRAFT || this == OPEN;
+            case DRAFT -> false;
+        };
+    }
+
+    /** Whether a claim at this status counts toward what its person has claimed. */
+    public boolean counts() {
+        return this == OPEN || this == SETTLED;
+    }
+}
diff --git a/src/main/resources/db/migration/V7__claim_status.sql b/src/main/resources/db/migration/V7__claim_status.sql
new file mode 100644
index 000000000..1680ad341
--- /dev/null
+++ b/src/main/resources/db/migration/V7__claim_status.sql
@@ -0,0 +1,4 @@
+-- A claim's status: DRAFT -> OPEN -> SETTLED, and a DRAFT or OPEN claim may be VOID.
+-- Only OPEN and SETTLED claims count toward what a person has claimed.
+ALTER TABLE claim ADD COLUMN status VARCHAR(10) NOT NULL DEFAULT 'DRAFT'
+    CHECK (status IN ('DRAFT', 'OPEN', 'SETTLED', 'VOID'));
