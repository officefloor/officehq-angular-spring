diff --git a/src/main/java/net/officefloor/hq/app/claim/ClaimStatus.java b/src/main/java/net/officefloor/hq/app/claim/ClaimStatus.java
new file mode 100644
index 000000000..90ef0c4ec
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/ClaimStatus.java
@@ -0,0 +1,17 @@
+package net.officefloor.hq.app.claim;
+
+import java.util.Set;
+
+/** A claim's status: DRAFT when added; it is opened, then settled; a DRAFT or OPEN claim can be voided. */
+public enum ClaimStatus {
+    DRAFT, OPEN, SETTLED, VOID;
+
+    /** Whether a claim in this status can move to the given one. */
+    public boolean canBecome(ClaimStatus to) {
+        return switch (this) {
+            case DRAFT -> Set.of(OPEN, VOID).contains(to);
+            case OPEN -> Set.of(SETTLED, VOID).contains(to);
+            case SETTLED, VOID -> false;
+        };
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/claim/ClaimStatusException.java b/src/main/java/net/officefloor/hq/app/claim/ClaimStatusException.java
new file mode 100644
index 000000000..d0851b29a
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/ClaimStatusException.java
@@ -0,0 +1,13 @@
+package net.officefloor.hq.app.claim;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.ResponseStatus;
+
+/** The claim's status does not allow the change asked for. */
+@ResponseStatus(HttpStatus.CONFLICT)
+public class ClaimStatusException extends RuntimeException {
+
+    public ClaimStatusException(ClaimStatus from, ClaimStatus to) {
+        super("A " + from + " claim cannot become " + to + ".");
+    }
+}
