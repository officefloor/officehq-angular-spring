+    /** Move a claim to its next status; a change its current status does not allow is refused. */
+    @Transactional
+    public Claim changeStatus(String sheetId, String user, long claimId, ClaimStatus next) {
+        Claim claim = claims.findByIdAndSheetId(claimId, sheetId)
+                .orElseThrow(() -> new ResponseStatusException(HttpStatus.NOT_FOUND, "No such claim"));
+        if (!claim.getStatus().canBecome(next)) {
+            throw new ResponseStatusException(HttpStatus.CONFLICT,
+                    "A " + claim.getStatus() + " claim cannot become " + next);
+        }
+        claim.setStatus(next);
+        Claim saved = claims.saveAndFlush(claim);
+        Person person = people.findByIdAndSheetId(saved.getPersonId(), sheetId)
+                .orElseThrow(() -> new ResponseStatusException(HttpStatus.NOT_FOUND, "No such person"));
+        String event = switch (next) {
+            case OPEN -> "CLAIM_OPENED";
+            case SETTLED -> "CLAIM_SETTLED";
+            default -> "CLAIM_VOIDED";
+        };
+        audit(sheetId, user, event, person, saved);
+        return saved;
+    }
+
     /** Amounts are written as the screen shows them (two decimals), dates as yyyy-mm-dd. */
     private void audit(String sheetId, String user, String event, Person person, Claim claim) {
         audit.recordOnCommit(event + " sheet=" + sheetId + " by=" + user + " person=" + person.getName()
diff --git a/src/main/java/net/officefloor/hq/app/claim/ClaimStatus.java b/src/main/java/net/officefloor/hq/app/claim/ClaimStatus.java
new file mode 100644
index 00000000..5562ebe3
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/ClaimStatus.java
@@ -0,0 +1,16 @@
+package net.officefloor.hq.app.claim;
+
+/** Where a claim is in its life: DRAFT, then OPEN, then SETTLED; a DRAFT or OPEN claim can be VOID. */
+public enum ClaimStatus {
+    DRAFT, OPEN, SETTLED, VOID;
+
+    /** Whether a claim in this status may move to {@code next}. */
+    public boolean canBecome(ClaimStatus next) {
+        return switch (next) {
+            case OPEN -> this == DRAFT;
+            case SETTLED -> this == OPEN;
+            case VOID -> this == DRAFT || this == OPEN;
+            case DRAFT -> false;
+        };
+    }
+}
diff --git a/src/main/resources/db/migration/V7__claim_status.sql b/src/main/resources/db/migration/V7__claim_status.sql
