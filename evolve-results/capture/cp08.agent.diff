+    /** Move a claim to another status, if its current one allows it; refused otherwise. */
+    @Transactional
+    public Claim changeStatus(String sheetId, String user, Long id, ClaimStatus status) {
+        Claim claim = claims.findByIdAndSheetId(id, sheetId)
+                .orElseThrow(() -> new ClaimNotFoundException(sheetId, id));
+        if (!claim.getStatus().canMoveTo(status)) {
+            throw new ClaimStatusException(id, claim.getStatus(), status);
+        }
+        claim.setStatus(status);
+        Claim saved = claims.saveAndFlush(claim);
+        Person person = people.findByIdAndSheetId(saved.getPersonId(), sheetId)
+                .orElseThrow(() -> new PersonNotFoundException(sheetId, saved.getPersonId()));
+        String event = switch (status) {
+            case OPEN -> "CLAIM_OPENED";
+            case SETTLED -> "CLAIM_SETTLED";
+            case VOID -> "CLAIM_VOIDED";
+            case DRAFT -> throw new IllegalStateException();
+        };
+        audit.recordOnCommit(record(event, user, person, saved));
+        return saved;
+    }
+
     /** The amount as shown (two decimals) and the date as yyyy-mm-dd. */
     private static String record(String event, String user, Person person, Claim claim) {
         return event + " sheet=" + claim.getSheetId() + " by=" + user + " person=" + person.getName()
diff --git a/src/main/java/net/officefloor/hq/app/claim/ClaimStatus.java b/src/main/java/net/officefloor/hq/app/claim/ClaimStatus.java
new file mode 100644
index 000000000..5c9709d89
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/ClaimStatus.java
@@ -0,0 +1,21 @@
+package net.officefloor.hq.app.claim;
+
+/** Where a claim is in its life: DRAFT, then OPEN, then SETTLED; a DRAFT or OPEN claim may be VOID. */
+public enum ClaimStatus {
+    DRAFT, OPEN, SETTLED, VOID;
+
+    /** Whether a claim in this status may move to the next one. */
+    public boolean canMoveTo(ClaimStatus next) {
+        return switch (next) {
+            case OPEN -> this == DRAFT;
+            case SETTLED -> this == OPEN;
+            case VOID -> this == DRAFT || this == OPEN;
+            case DRAFT -> false;
+        };
+    }
+
+    /** Whether a claim in this status counts toward claimed and the totals. */
+    public boolean counts() {
+        return this == OPEN || this == SETTLED;
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/claim/ClaimStatusException.java b/src/main/java/net/officefloor/hq/app/claim/ClaimStatusException.java
