diff --git a/src/main/java/net/officefloor/hq/app/claim/ClaimStatus.java b/src/main/java/net/officefloor/hq/app/claim/ClaimStatus.java
new file mode 100644
index 00000000..5d689c4d
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/ClaimStatus.java
@@ -0,0 +1,16 @@
+package net.officefloor.hq.app.claim;
+
+/** Where a claim is in its life: DRAFT, then OPEN, then SETTLED; a DRAFT or OPEN claim can be VOID. */
+public enum ClaimStatus {
+    DRAFT, OPEN, SETTLED, VOID;
+
+    /** Whether a claim in this status may move to `next`. */
+    public boolean canBecome(ClaimStatus next) {
+        return switch (next) {
+            case OPEN -> this == DRAFT;
+            case SETTLED -> this == OPEN;
+            case VOID -> this == DRAFT || this == OPEN;
+            case DRAFT -> false;
+        };
+    }
+}
diff --git a/src/main/resources/db/migration/V7__claim_status.sql b/src/main/resources/db/migration/V7__claim_status.sql
new file mode 100644
index 00000000..aaa68a34
--- /dev/null
+++ b/src/main/resources/db/migration/V7__claim_status.sql
@@ -0,0 +1,4 @@
+-- A claim's status: DRAFT -> OPEN -> SETTLED, and DRAFT or OPEN -> VOID. Only OPEN and SETTLED
+-- claims count toward what a person has claimed and what is due.
+ALTER TABLE claim ADD COLUMN status VARCHAR(10) DEFAULT 'DRAFT' NOT NULL
+    CHECK (status IN ('DRAFT', 'OPEN', 'SETTLED', 'VOID'));
