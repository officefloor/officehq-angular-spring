+    @Transactional
+    public Claim changeStatus(String sheetId, String user, Long id, ClaimStatus next) {
+        Claim claim = claims.findByIdAndSheetId(id, sheetId).orElseThrow(ClaimNotFoundException::new);
+        if (!claim.getStatus().canBecome(next)) {
+            throw new ClaimStatusRefusedException();
+        }
+        claim.setStatus(next);
+        Claim saved = claims.saveAndFlush(claim);
+        Person person = people.findByIdAndSheetId(saved.getPersonId(), sheetId).orElseThrow(PersonNotFoundException::new);
+        String event = switch (next) {
+            case OPEN -> "CLAIM_OPENED";
+            case SETTLED -> "CLAIM_SETTLED";
+            case VOID -> "CLAIM_VOIDED";
+            case DRAFT -> throw new IllegalStateException();
+        };
+        record(event, sheetId, user, person, saved);
+        return saved;
+    }
+
     private void record(String event, String sheetId, String user, Person person, Claim claim) {
         audit.recordOnCommit(event + " sheet=" + sheetId + " by=" + user.strip() + " person=" + person.getName()
                 + " amount=" + claim.getAmount().setScale(2).toPlainString() + " date=" + claim.getDate());
diff --git a/src/main/java/net/officefloor/hq/app/claim/ClaimStatus.java b/src/main/java/net/officefloor/hq/app/claim/ClaimStatus.java
new file mode 100644
index 000000000..455f95387
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/ClaimStatus.java
@@ -0,0 +1,24 @@
+package net.officefloor.hq.app.claim;
+
+/**
+ * A claim's status. It starts as DRAFT, is opened (OPEN) and then settled (SETTLED); a DRAFT or
+ * OPEN claim can be voided (VOID). SETTLED and VOID are final.
+ */
+public enum ClaimStatus {
+    DRAFT, OPEN, SETTLED, VOID;
+
+    /** Whether a claim in this status may move to {@code next}. */
+    public boolean canBecome(ClaimStatus next) {
+        return switch (next) {
+            case OPEN -> this == DRAFT;
+            case SETTLED -> this == OPEN;
+            case VOID -> this == DRAFT || this == OPEN;
+            case DRAFT -> false;
+        };
+    }
+
+    /** Whether a claim in this status counts toward what is claimed and due. */
+    public boolean counts() {
+        return this == OPEN || this == SETTLED;
+    }
+}
