 function cutsOf(potCents: bigint, members: readonly MemberRow[]): [string, bigint][] {
   const shares = members.map((m) => (m.retired || m.held ? 0 : cents(m.share)));
   const total = BigInt(shares.reduce((t, share) => t + share, 0));
