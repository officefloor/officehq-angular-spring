+    @Transactional
+    public Sheet setMaxOpen(String by, String sheetId, Integer max) {
+        Sheet sheet = sheets.lock(sheetId);
+        sheet.setMaxOpen(max);
+        Sheet saved = sheetRepository.saveAndFlush(sheet);
