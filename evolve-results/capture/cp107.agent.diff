+      if (this.session.sheetId() !== sheet) return;
+      await this.load(sheet);
+    } catch (e) {
+      if (this.session.sheetId() !== sheet) return;
+      this.personError.set({
+        id: p.id,
+        message: e instanceof HttpErrorResponse && e.status === 409
