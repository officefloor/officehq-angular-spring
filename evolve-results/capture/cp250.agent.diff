+  protected async exportPolicy(): Promise<void> {
+    await this.session.loaded();
+    const byId = new Map(this.people.people().map((p) => [p.id, p]));
+    const live = new Set(this.claims.live().map((c) => c.id));
+    const counts = new Map<number, number>();
+    const dues = new Map<number, bigint>();
+    for (const c of this.claims.claims()) {
+      const n = this.session.policyVersionOn(c.date);
+      counts.set(n, (counts.get(n) ?? 0) + 1);
+      const p = byId.get(c.personId);
+      if (p && live.has(c.id)) dues.set(n, (dues.get(n) ?? 0n) + this.figures.figureCents(c, p));
+    }
+    const lines = [['version', 'from', 'key', 'value', 'claims', 'due-total']];
+    this.session.policyVersions().forEach((v, i) => {
+      const n = i + 1;
+      lines.push([String(n), v.from ?? '', v.key, v.value ?? '', String(counts.get(n) ?? 0), money(dues.get(n) ?? 0n)]);
+    });
