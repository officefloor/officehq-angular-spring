diff --git a/src/main/resources/db/migration/V58__claim_comment.sql b/src/main/resources/db/migration/V58__claim_comment.sql
new file mode 100644
index 000000000..090d3d600
--- /dev/null
+++ b/src/main/resources/db/migration/V58__claim_comment.sql
@@ -0,0 +1,9 @@
+-- Each claim's comments, oldest first: the text, who wrote it and the sheet's today when it was written.
+CREATE TABLE claim_comment (
+    claim_id     BIGINT        NOT NULL REFERENCES claim (id),
+    seq          INT           NOT NULL,
+    by_user      VARCHAR(100)  NOT NULL,
+    comment_date DATE          NOT NULL,
+    comment_text VARCHAR(500)  NOT NULL,
+    PRIMARY KEY (claim_id, seq)
+);
