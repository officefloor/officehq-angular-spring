diff --git a/src/main/resources/db/migration/V15__claim_void_keeps_number.sql b/src/main/resources/db/migration/V15__claim_void_keeps_number.sql
new file mode 100644
index 00000000..9f20ab92
--- /dev/null
+++ b/src/main/resources/db/migration/V15__claim_void_keeps_number.sql
@@ -0,0 +1,4 @@
+-- Only a DRAFT claim can be edited; an OPEN claim is changed by voiding it and adding a new one.
+-- A voided claim now keeps the number it was given when opened (still never given again).
+-- Claims voided before this change had their number cleared, and it cannot be recovered.
+SELECT 1;
