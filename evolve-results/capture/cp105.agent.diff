+
+/** A pool on a sheet: a name, unique on the sheet, whose members each hold a share percent. */
+@Entity
+@Table(name = "pool")
+public class Pool {
+
+    @Id
+    @GeneratedValue(strategy = GenerationType.IDENTITY)
+    private Long id;
+
+    @Column(name = "sheet_id", nullable = false)
