+  protected readonly maxThrum = computed(() => {
+    let top: Person | null = null;
+    for (const p of this.people()) {
+      if (p.thrum === null) continue;
+      if (
+        top === null ||
+        p.thrum > top.thrum! ||
+        (p.thrum === top.thrum && p.name.localeCompare(top.name) < 0)
+      ) {
+        top = p;
+      }
+    }
+    return top?.name ?? null;
+  });
 
