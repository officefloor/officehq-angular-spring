+package net.officefloor.hq.app.adjustmentnote;
+
+import jakarta.validation.Valid;
+import java.util.List;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+/** The adjustment notes issued against a sent invoice to correct it, oldest first. */
+@RestController
+@RequestMapping("/api/projects/{projectId}/invoices/{invoiceId}/adjustment-notes")
+public class InvoiceAdjustmentNoteController {
+
+    private final AdjustmentNoteService service;
+
+    public InvoiceAdjustmentNoteController(AdjustmentNoteService service) {
+        this.service = service;
+    }
+
+    @GetMapping
+    public List<AdjustmentNoteResponse> list(@PathVariable Long projectId, @PathVariable Long invoiceId) {
+        return service.list(projectId, invoiceId);
+    }
+
+    @PostMapping
+    @ResponseStatus(HttpStatus.CREATED)
+    public AdjustmentNoteResponse issue(@PathVariable Long projectId, @PathVariable Long invoiceId,
+            @Valid @RequestBody AdjustmentNoteRequest request) {
+        return service.issue(projectId, invoiceId, request);
+    }
+}
