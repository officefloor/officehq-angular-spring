+/** A sheet's settled-total in cents as the sheet shows it: its people's, trimmed. */
+function settledTotalOf(people: Person[]): number {
+  return trimmedSum(people.map((p) => cents(p.settledTotal)));
+}
+
+/** A sheet's open-total in cents as the sheet shows it: its people's, trimmed. */
+function openTotalOf(people: Person[]): number {
+  return trimmedSum(people.map((p) => cents(p.openTotal)));
+}
+
+/** A sheet's cut total in cents: its people's cuts (none counting as 0.00), trimmed. */
+function cutTotalOf(people: Person[], cuts: ReadonlyMap<number, number>): number {
+  return trimmedSum(people.map((p) => cuts.get(p.id) ?? 0));
+}
+
+/** Per person id, in cents, their cuts across every pool they are a member of; a pool showing no cut adds nothing. */
+function cutsOf(pools: Pool[]): Map<number, number> {
+  const cuts = new Map<number, number>();
+  for (const pool of pools) {
+    for (const m of pool.members) {
+      if (m.personId !== null && m.cut !== null) cuts.set(m.personId, (cuts.get(m.personId) ?? 0) + cents(m.cut));
+    }
+  }
+  return cuts;
+}
