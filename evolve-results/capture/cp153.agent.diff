diff --git a/src/main/java/net/officefloor/hq/app/rate/RateVersion.java b/src/main/java/net/officefloor/hq/app/rate/RateVersion.java
new file mode 100644
index 000000000..e5b1a77f3
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/rate/RateVersion.java
@@ -0,0 +1,73 @@
+package net.officefloor.hq.app.rate;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Entity;
+import jakarta.persistence.GeneratedValue;
+import jakarta.persistence.GenerationType;
+import jakarta.persistence.Id;
+import jakarta.persistence.Table;
+import java.math.BigDecimal;
+import java.time.LocalDate;
+
+/** An older version of a rate: the value (and to-date) a later setting of the same grade and from-date
+ *  replaced. */
+@Entity
+@Table(name = "rate_version")
+public class RateVersion {
+
+    @Id
+    @GeneratedValue(strategy = GenerationType.IDENTITY)
+    private Long id;
+
+    @Column(name = "rate_id", nullable = false)
+    private Long rateId;
+
+    @Column(name = "version", nullable = false)
+    private int version;
+
+    @Column(name = "rate", nullable = false)
+    private BigDecimal rate;
+
+    @Column(name = "to_date")
+    private LocalDate toDate;
+
+    /** Who set the replacing version. */
+    @Column(name = "set_by")
+    private String setBy;
+
+    protected RateVersion() {
+    }
+
+    /** The version a rate is in now, kept as it is replaced by a user. */
+    public RateVersion(Rate replaced, String setBy) {
+        this.rateId = replaced.getId();
+        this.version = replaced.getVersion();
+        this.rate = replaced.getRate();
+        this.toDate = replaced.getToDate();
+        this.setBy = setBy;
+    }
+
+    public Long getId() {
+        return id;
+    }
+
+    public Long getRateId() {
+        return rateId;
+    }
+
+    public int getVersion() {
+        return version;
+    }
+
+    public BigDecimal getRate() {
+        return rate;
+    }
+
+    public LocalDate getToDate() {
+        return toDate;
+    }
+
+    public String getSetBy() {
+        return setBy;
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/rate/RateVersionRepository.java b/src/main/java/net/officefloor/hq/app/rate/RateVersionRepository.java
new file mode 100644
index 000000000..6d0d0a46b
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/rate/RateVersionRepository.java
@@ -0,0 +1,10 @@
+package net.officefloor.hq.app.rate;
+
+import java.util.List;
+import org.springframework.data.jpa.repository.JpaRepository;
+
+public interface RateVersionRepository extends JpaRepository<RateVersion, Long> {
+
+    /** A rate's older versions, oldest first. */
+    List<RateVersion> findByRateIdOrderByVersionAsc(Long rateId);
+}
diff --git a/src/main/resources/db/migration/V83__rate_version.sql b/src/main/resources/db/migration/V83__rate_version.sql
new file mode 100644
index 000000000..a3838a662
--- /dev/null
+++ b/src/main/resources/db/migration/V83__rate_version.sql
@@ -0,0 +1,14 @@
+-- A rate is kept as versions: setting a grade's rate for a from-date it already has keeps the value it
+-- replaces as an older version and makes the new one the rate in force. The rate row holds the newest
+-- version and how many versions it has had (1 for a rate never replaced); its older versions are kept
+-- here, oldest first (by version).
+ALTER TABLE rate ADD COLUMN version INTEGER DEFAULT 1 NOT NULL CHECK (version >= 1);
+CREATE TABLE rate_version (
+    id         BIGINT        GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
+    rate_id    BIGINT        NOT NULL REFERENCES rate (id),
+    version    INTEGER       NOT NULL,
+    rate       DECIMAL(9, 2) NOT NULL,
+    to_date    DATE,
+    set_by     VARCHAR(200)
+);
+CREATE UNIQUE INDEX rate_version_rate ON rate_version (rate_id, version);
