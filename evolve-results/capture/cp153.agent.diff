diff --git a/src/main/java/net/officefloor/hq/app/rate/RateVersion.java b/src/main/java/net/officefloor/hq/app/rate/RateVersion.java
new file mode 100644
index 000000000..f69eeb804
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/rate/RateVersion.java
@@ -0,0 +1,59 @@
+package net.officefloor.hq.app.rate;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Entity;
+import jakarta.persistence.GeneratedValue;
+import jakarta.persistence.GenerationType;
+import jakarta.persistence.Id;
+import jakarta.persistence.Table;
+import java.math.BigDecimal;
+import java.time.LocalDate;
+
+/** An older version of a rate: its percent and to-date as they stood before the version after it
+ *  replaced them. The rate itself holds its newest version. */
+@Entity
+@Table(name = "rate_version")
+public class RateVersion {
+
+    @Id
+    @GeneratedValue(strategy = GenerationType.IDENTITY)
+    private Long id;
+
+    @Column(name = "rate_id", nullable = false)
+    private Long rateId;
+
+    @Column(name = "version", nullable = false)
+    private int version;
+
+    @Column(name = "pct", nullable = false, precision = 5, scale = 2)
+    private BigDecimal pct;
+
+    @Column(name = "to_date")
+    private LocalDate to;
+
+    protected RateVersion() {
+    }
+
+    public RateVersion(Long rateId, int version, BigDecimal pct, LocalDate to) {
+        this.rateId = rateId;
+        this.version = version;
+        this.pct = pct;
+        this.to = to;
+    }
+
+    public Long getRateId() {
+        return rateId;
+    }
+
+    public int getVersion() {
+        return version;
+    }
+
+    public BigDecimal getPct() {
+        return pct;
+    }
+
+    public LocalDate getTo() {
+        return to;
+    }
+}
