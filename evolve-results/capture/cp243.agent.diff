+  /** Download the person's row as it shows now, as a CSV file: one line per cell, each with the value as the row
+   *  shows it, columns hidden from the table included. */
+  protected exportPerson(p: Person): void {
+    const sheet = this.session.sheet();
+    if (!sheet) return;
+    const locale = this.session.locale();
+    const figure = (v: string) => String(formatFigure(v, locale));
+    const cells: [string, string][] = [
+      ['person-name', `${p.name} (${p.grade})`],
+      ['person-grade', p.grade],
+      ['person-claimed', figure(p.claimed)],
+      ['person-due-total', figure(p.dueTotal ?? 'n/a')],
+      ['person-statement-count', String(p.statementCount)],
+      ['person-overdue-total', figure(p.overdueTotal)],
+      ['person-hold', p.held ? 'yes' : 'no'],
+      ['person-retired', p.retired ? 'yes' : 'no'],
+      ['person-aliases', (p.aliases ?? []).join(', ')],
+      ['person-score', String(p.score)],
+    ];
+    const lines = ['cell,value', ...cells.map((c) => c.map(csvField).join(','))];
+    const url = URL.createObjectURL(new Blob([lines.map((l) => l + '\n').join('')], { type: 'text/csv' }));
+    const link = document.createElement('a');
+    link.href = url;
+    link.download = `person-${sheet}-${p.id}.csv`;
+    link.click();
+    setTimeout(() => URL.revokeObjectURL(url));
+  }
