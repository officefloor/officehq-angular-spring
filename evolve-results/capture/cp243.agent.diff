+  /** Downloads a person's row as CSV: a header line cell,value then one line per cell, each with
+   *  the value as the row shows it. */
+  protected exportPersonCsv(p: Person): void {
+    const fig = (v: string | number | null | undefined) => (v === null || v === undefined ? '' : formatFigure(String(v), this.session.locale()));
+    const lines = [
+      ['cell', 'value'],
+      ['person-name', this.nameOf(p)],
+      ['person-grade', this.gradeOf(p)],
+      ['person-claimed', fig(this.claimed().get(p.id) ?? '0.00')],
+      ['person-due-total', fig(this.dueOf(p) ?? 'n/a')],
+      ['person-statement-count', String(p.statementCount)],
+      ['person-overdue-total', fig(this.overdueTotalOf(p))],
+      ['person-hold', p.held ? 'yes' : 'no'],
+      ['person-retired', p.retired ? 'yes' : 'no'],
+      ['person-aliases', p.aliases.join(', ')],
+      ['person-score', String(this.scoreOf(p))],
+    ];
+    downloadCsv(lines, 'person-' + p.name + '.csv');
+  }
