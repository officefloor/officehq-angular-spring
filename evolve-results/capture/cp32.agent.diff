+    public LocalDate policyDate(String id) {
+        return sheets.findById(id).map(Sheet::getPolicyDate).orElse(null);
+    }
+
+    /** The policy date in force: the one set, or else the sheet's today. */
+    @Transactional(readOnly = true)
+    public LocalDate policyDateInForce(String id) {
+        return sheets.findById(id).map(s -> s.getPolicyDate() != null ? s.getPolicyDate() : s.getToday())
+                .orElseGet(LocalDate::now);
+    }
+
+    /** Change the sheet's policy date (null: blank, the sheet's today); recorded even when it is
+     *  unchanged, then the figures it moves. */
+    @Transactional
+    public synchronized Sheet setPolicyDate(String id, String user, LocalDate policyDate) {
+        Sheet sheet = load(id, user);
+        return rollup.tracking(id, user, () -> {
+            sheet.setPolicyDate(policyDate);
+            Sheet saved = sheets.saveAndFlush(sheet);
+            audit.recordOnCommit("SETTING_CHANGED sheet=" + id + " by=" + user + " key=policy-date value="
+                    + (policyDate == null ? "" : policyDate.toString()));
+            return saved;
+        });
+    }
 }
diff --git a/src/main/resources/db/migration/V25__policy_date.sql b/src/main/resources/db/migration/V25__policy_date.sql
new file mode 100644
index 000000000..ff54abedf
--- /dev/null
+++ b/src/main/resources/db/migration/V25__policy_date.sql
@@ -0,0 +1,9 @@
+-- The sheet's policy date: a claim dated before it rounds half up, one on or after it half to even;
+-- null (blank) takes the sheet's today.
+ALTER TABLE sheet ADD COLUMN policy_date DATE;
+-- A correction rounds by the date of the claim it corrects, kept with it; null for a claim that is
+-- not a correction.
+ALTER TABLE claim ADD COLUMN corrected_date DATE;
+UPDATE claim c SET corrected_date = (SELECT o.claim_date FROM claim o WHERE o.sheet_id = c.sheet_id
+    AND o.person_id = c.person_id AND o.number = c.corrects AND o.status = 'SETTLED')
+    WHERE c.corrects IS NOT NULL;
