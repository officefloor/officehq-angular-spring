+    try {
+      const saved = await firstValueFrom(this.http.post<Person>(url, { alias }));
+      if (this.session.sheetId() !== sheet) return;
+      this.people.update((list) => list.map((q) => (q.id === saved.id ? saved : q)));
+      this.aliasInputs.update(({ [p.id]: _, ...rest }) => rest);
