diff --git a/src/main/resources/db/migration/V63__person_alias.sql b/src/main/resources/db/migration/V63__person_alias.sql
new file mode 100644
index 000000000..3218a4748
--- /dev/null
+++ b/src/main/resources/db/migration/V63__person_alias.sql
@@ -0,0 +1,7 @@
+-- A person's aliases: each stored with surrounding spaces removed. An alias shares the names'
+-- uniqueness on the sheet (compared without regard to case), which the service keeps.
+CREATE TABLE person_alias (
+    person_id BIGINT       NOT NULL REFERENCES person (id),
+    alias     VARCHAR(200) NOT NULL,
+    PRIMARY KEY (person_id, alias)
+);
