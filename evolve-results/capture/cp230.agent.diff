diff --git a/src/main/resources/db/migration/V122__pending_sla.sql b/src/main/resources/db/migration/V122__pending_sla.sql
new file mode 100644
index 000000000..e7d0cc95b
--- /dev/null
+++ b/src/main/resources/db/migration/V122__pending_sla.sql
@@ -0,0 +1,3 @@
+-- The sheet's pending SLA: a PENDING claim whose pending day (the sheet's today when it last went to PENDING)
+-- plus this many days is before the sheet's today is pending late. None means none. Not dated.
+ALTER TABLE sheet ADD COLUMN pending_sla INTEGER CHECK (pending_sla >= 0);
