+    @Transactional(readOnly = true)
+    public Map<Long, List<ClaimPlanPause>> pauses(String sheetId) {
+        Map<Long, List<ClaimPlanPause>> by = new HashMap<>();
+        for (ClaimPlanPause p : pauses.findBySheetId(sheetId)) {
