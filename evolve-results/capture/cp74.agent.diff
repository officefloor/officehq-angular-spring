diff --git a/src/main/resources/db/migration/V28__fx_rate.sql b/src/main/resources/db/migration/V28__fx_rate.sql
new file mode 100644
index 0000000..479d00b
--- /dev/null
+++ b/src/main/resources/db/migration/V28__fx_rate.sql
@@ -0,0 +1,9 @@
+-- Dated exchange rates: from a date on, the US dollars one unit of the currency is worth. Something
+-- converted on a date uses the latest dated rate on or before it, or the standing usd_per_<code>
+-- setting before any.
+CREATE TABLE fx_rate (
+    id        BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
+    from_date DATE           NOT NULL,
+    currency  VARCHAR(3)     NOT NULL,
+    usd_per   DECIMAL(19, 8) NOT NULL
+);
