-    public AuditController(Audit audit) {
+    public AuditController(Audit audit, PersonRepository people) {
         this.audit = audit;
+        this.people = people;
     }
 
-    /** The sheet's audit lines, newest first; with a name, only the lines about that person. */
+    /**
+     * The sheet's audit lines, newest first; with a name, only the lines about that person, then, when
+     * they came from another sheet, that sheet's lines about them by their name or an alias.
+     */
     @GetMapping
     public List<String> lines(
             @PathVariable @NotBlank @Size(max = 64) @Pattern(regexp = "[A-Za-z0-9._-]+") String sheetId,
             @RequestParam(required = false) @Size(max = 200) String name) {
