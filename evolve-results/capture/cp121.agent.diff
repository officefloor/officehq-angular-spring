+        if (!who.isEmpty()) {
+            people.findBySheetIdAndNameIgnoreCase(id, who).stream()
+                    .map(Person::getOriginSheetId).filter(Objects::nonNull).findFirst()
+                    .ifPresent(origin -> lines.addAll(audit.lines(origin, who)));
+        }
+        return lines;
     }
 }
