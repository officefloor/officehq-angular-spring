+@Embeddable
+public class PersonGrade {
+
+    @Column(name = "from_date")
+    private LocalDate from;
+
+    @Column(name = "grade", nullable = false)
+    private String grade;
+
+    protected PersonGrade() {
+    }
+
+    public PersonGrade(LocalDate from, String grade) {
+        this.from = from;
+        this.grade = grade;
