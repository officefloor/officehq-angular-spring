new file mode 100644
index 00000000..ee01bef6
--- /dev/null
+++ b/src/main/frontend/src/app/core/figure.pipe.ts
@@ -0,0 +1,24 @@
+import { Pipe, PipeTransform, inject } from '@angular/core';
+import { UserLocale } from './user-locale';
+
+const FIGURE = /^(-?)(\d+)\.(\d{2})$/;
+
+/** A figure (a number with two decimals, as the store gives it) shown in the signed-in user's
+ *  locale: under de as 1.234,56, under en as it is. Anything else is shown as it is. */
+export function showFigure(value: string, locale: string): string {
+  if (locale !== 'de') return value;
+  const m = FIGURE.exec(value.trim());
+  if (!m) return value;
+  return `${m[1]}${m[2].replace(/\B(?=(\d{3})+$)/g, '.')},${m[3]}`;
+}
+
+// Impure, so a change of the user's locale (a signal) re-shows every figure.
+@Pipe({ name: 'figure', pure: false })
+export class FigurePipe implements PipeTransform {
+  private readonly userLocale = inject(UserLocale);
+
+  transform(value: unknown): string {
+    const text = value === null || value === undefined ? '' : String(value);
+    return showFigure(text, this.userLocale.locale());
+  }
+}
diff --git a/src/main/frontend/src/app/core/user-locale.ts b/src/main/frontend/src/app/core/user-locale.ts
new file mode 100644
index 00000000..90fe9af6
--- /dev/null
+++ b/src/main/frontend/src/app/core/user-locale.ts
@@ -0,0 +1,38 @@
+import { HttpClient } from '@angular/common/http';
+import { Injectable, effect, inject, signal } from '@angular/core';
+import { firstValueFrom } from 'rxjs';
+import { Session } from './session';
+
+/** The locales a user can choose: how the screen shows them figures. */
+export const LOCALES = ['en', 'de'] as const;
+export type Locale = (typeof LOCALES)[number];
+
+// The signed-in user's locale, saved per user in the store (en until they choose one). It changes
+// only how figures are shown; entries are typed with a dot, and exports are unchanged.
+@Injectable({ providedIn: 'root' })
+export class UserLocale {
+  private readonly http = inject(HttpClient);
+  private readonly session = inject(Session);
+
+  private readonly localeState = signal<Locale>('en');
+  readonly locale = this.localeState.asReadonly();
+
+  constructor() {
+    effect(() => {
+      const user = this.session.user();
+      this.localeState.set('en');
+      if (user) void this.load(user);
+    });
+  }
+
+  private async load(user: string): Promise<void> {
+    const view = await firstValueFrom(this.http.get<{ locale: Locale }>('/api/me/locale'));
+    if (this.session.user() === user) this.localeState.set(view.locale);
+  }
+
+  /** Save the signed-in user's locale; the store's answer is what the screen then uses. */
+  async save(locale: Locale): Promise<void> {
+    const view = await firstValueFrom(this.http.put<{ locale: Locale }>('/api/me/locale', { locale }));
+    this.localeState.set(view.locale);
+  }
+}
