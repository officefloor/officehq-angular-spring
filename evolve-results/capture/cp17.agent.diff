+-- A period on a sheet: a name, unique on the sheet ignoring case and surrounding spaces (name_key is
+-- the trimmed name lower-cased), and a from and to date, both inclusive. No two periods on a sheet
+-- overlap (kept by the app). A claim belongs to the period whose dates contain its date, or to none.
+CREATE TABLE period (
+    id        BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id  VARCHAR(64)  NOT NULL REFERENCES sheet (id),
+    name      VARCHAR(200) NOT NULL,
+    name_key  VARCHAR(200) NOT NULL,
+    from_date DATE         NOT NULL,
+    to_date   DATE         NOT NULL,
+    CHECK (from_date <= to_date)
+);
+CREATE UNIQUE INDEX period_sheet_name ON period (sheet_id, name_key);
