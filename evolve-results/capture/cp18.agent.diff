+                due = grade == null ? null : inForce(sheetRates, grade, claim.getDate())
+                        .map(rate -> claim.getAmount().multiply(rate.getRate()).movePointLeft(2)
+                                .setScale(2, RoundingMode.HALF_EVEN))
+                        .orElse(null);
+            }
+            if (due != null) {
+                total = total.add(due);
