+  claim: Claim,
+  rates: Rate[],
+  grade: Grade,
+  floorCents: number,
+  late: Lateness,
+): number | null {
+  const figure = claimDueCents(claim, rates, grade, floorCents);
+  return figure === null ? null : figure + lateChargeCents(claim, figure, late);
