+-- The sheet's late percent: an overdue claim's due gains this percent of its figure for every full 30 days
+-- it is overdue. A sheet starts at 0.00.
+ALTER TABLE sheet ADD COLUMN late_pct DECIMAL(9, 2) DEFAULT 0.00 NOT NULL CHECK (late_pct >= 0);
