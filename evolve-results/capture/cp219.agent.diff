+                last.getOpenings().forEach(first::takeOpening);
+                periods.saveAndFlush(first);
+            });
+        }
+        periods.deleteAll(generated);
+        periods.flush();
+        lastRollovers.delete(last);
+        lastRollovers.flush();
+        audit.recordOnCommit("ROLLOVER_UNDONE sheet=" + sheetId + " by=" + user + " fy=" + last.getFy());
+    }
