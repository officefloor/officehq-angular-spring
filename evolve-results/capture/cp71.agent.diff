+  protected readonly topCrest = computed(() => {
+    let top: Person | null = null;
+    for (const p of this.people()) {
+      if (p.crest === null) continue;
+      if (
+        top === null ||
+        p.crest > top.crest! ||
+        (p.crest === top.crest && p.name.localeCompare(top.name) < 0)
+      ) {
+        top = p;
+      }
+    }
+    return top?.name ?? null;
+  });
 
