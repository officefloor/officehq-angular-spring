diff --git a/src/main/resources/db/migration/V109__role_restricted.sql b/src/main/resources/db/migration/V109__role_restricted.sql
new file mode 100644
index 000000000..b889e69c1
--- /dev/null
+++ b/src/main/resources/db/migration/V109__role_restricted.sql
@@ -0,0 +1,13 @@
+-- A fourth role, restricted: sees on the people list only the people of the crews led by or holding the person with
+-- the user's name, and that person.
+CREATE TABLE sheet_role_new (
+    id        BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id  VARCHAR(100) NOT NULL REFERENCES sheet (id),
+    user_name VARCHAR(100) NOT NULL,
+    role      VARCHAR(20)  NOT NULL CHECK (role IN ('clerk', 'steward', 'viewer', 'restricted'))
+);
+INSERT INTO sheet_role_new (id, sheet_id, user_name, role) SELECT id, sheet_id, user_name, role FROM sheet_role;
+DROP TABLE sheet_role;
+ALTER TABLE sheet_role_new RENAME TO sheet_role;
+ALTER TABLE sheet_role ALTER COLUMN id RESTART WITH (SELECT COALESCE(MAX(id), 0) + 1 FROM sheet_role);
+CREATE UNIQUE INDEX sheet_role_user ON sheet_role (sheet_id, user_name);
