diff --git a/src/main/resources/db/migration/V113__restricted_role.sql b/src/main/resources/db/migration/V113__restricted_role.sql
new file mode 100644
index 000000000..0b71a178f
--- /dev/null
+++ b/src/main/resources/db/migration/V113__restricted_role.sql
@@ -0,0 +1,13 @@
+-- A fourth role, restricted: sees on the people list only the people of the crews they lead or belong
+-- to and themselves. The role check is rebuilt to allow it.
+CREATE TABLE sheet_role_new (
+    id BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id VARCHAR(200) NOT NULL REFERENCES sheet (id),
+    user_name VARCHAR(200) NOT NULL,
+    role VARCHAR(20) NOT NULL,
+    CHECK (role IN ('clerk', 'steward', 'viewer', 'restricted'))
+);
+INSERT INTO sheet_role_new (sheet_id, user_name, role) SELECT sheet_id, user_name, role FROM sheet_role ORDER BY id;
+DROP TABLE sheet_role;
+ALTER TABLE sheet_role_new RENAME TO sheet_role;
+CREATE UNIQUE INDEX sheet_role_sheet_user ON sheet_role (sheet_id, user_name);
