+  /** Download the period figures as CSV: people in list order, each one's periods in the order added, with
+   *  person, period, the due-total figure and the carried figure as the person's row shows them. */
+  protected exportPeriods(): void {
+    const periods = [...this.periods()].sort((a, b) => a.id - b.id);
+    const lines = [csvLine(['person', 'period', 'figure', 'carried'])];
+    for (const p of this.people()) {
+      for (const period of periods) {
+        lines.push(csvLine([p.name, period.name, money(this.periodDueOf(p.id, period)), money(this.carriedOf(p.id, period))]));
+      }
+    }
+    this.download(lines.join(''), `periods-${this.session.sheetId()}.csv`);
+  }
