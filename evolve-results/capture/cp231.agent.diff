+  /** Downloads the period figures as CSV: one line per person (retired included, in list order)
+   *  and period (in the order added), with the due-total and carried figure as the row shows them. */
+  protected async exportPeriodsCsv(): Promise<void> {
+    await this.loaded();
+    const periods = [...this.periods()].sort((a, b) => a.id - b.id);
+    const lines = [['person', 'period', 'figure', 'carried']].concat(
+      this.people().flatMap((p) => periods.map((pd) => [p.name, pd.name, this.periodDueOf(p.id, pd), this.carriedOf(p.id, pd)])),
+    );
+    downloadCsv(lines, 'periods.csv');
+  }
