diff --git a/src/main/resources/db/migration/V11__claim_opened_by.sql b/src/main/resources/db/migration/V11__claim_opened_by.sql
new file mode 100644
index 00000000..3722156d
--- /dev/null
+++ b/src/main/resources/db/migration/V11__claim_opened_by.sql
@@ -0,0 +1,3 @@
+-- Who opened a claim: set when the claim is opened, cleared once it is voided. The user who
+-- opened a claim cannot settle it.
+ALTER TABLE claim ADD COLUMN opened_by VARCHAR(100);
