diff --git a/src/main/java/net/officefloor/hq/app/claim/OwnClaimSettleRefusedException.java b/src/main/java/net/officefloor/hq/app/claim/OwnClaimSettleRefusedException.java
new file mode 100644
index 000000000..07cadca63
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/OwnClaimSettleRefusedException.java
@@ -0,0 +1,9 @@
+package net.officefloor.hq.app.claim;
+
+/** The user who opened a claim cannot settle it: another user must. */
+public class OwnClaimSettleRefusedException extends RuntimeException {
+
+    public OwnClaimSettleRefusedException(String user) {
+        super("A claim opened by " + user + " must be settled by someone else");
+    }
+}
diff --git a/src/main/resources/db/migration/V11__claim_opened_by.sql b/src/main/resources/db/migration/V11__claim_opened_by.sql
new file mode 100644
index 000000000..a09130f37
--- /dev/null
+++ b/src/main/resources/db/migration/V11__claim_opened_by.sql
@@ -0,0 +1,3 @@
+-- Who opened a claim: the signed-in user who moved it from DRAFT to OPEN; null for a claim never
+-- opened. That user may not settle it.
+ALTER TABLE claim ADD COLUMN opened_by VARCHAR(200);
