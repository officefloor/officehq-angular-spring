diff --git a/src/main/java/net/officefloor/hq/app/claim/ClaimSettlerException.java b/src/main/java/net/officefloor/hq/app/claim/ClaimSettlerException.java
new file mode 100644
index 000000000..737e330b4
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/ClaimSettlerException.java
@@ -0,0 +1,13 @@
+package net.officefloor.hq.app.claim;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.ResponseStatus;
+
+/** The user who opened a claim asked to settle it: a claim needs a second pair of eyes to be settled. */
+@ResponseStatus(HttpStatus.CONFLICT)
+public class ClaimSettlerException extends RuntimeException {
+
+    public ClaimSettlerException() {
+        super("The user who opened a claim cannot settle it.");
+    }
+}
