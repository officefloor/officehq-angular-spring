+
+/** A CSV field: quoted, with quotes doubled, when it holds a comma, a quote or a line break. */
+function csvField(v: string): string {
+  return /[",\r\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v;
+}
