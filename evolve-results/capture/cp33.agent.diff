+/** A CSV field: wrapped in double quotes, with any quote inside doubled, when it holds a comma, a
+ *  quote or a line break. */
+function csvField(value: string): string {
+  return /[",\r\n]/.test(value) ? `"${value.replaceAll('"', '""')}"` : value;
