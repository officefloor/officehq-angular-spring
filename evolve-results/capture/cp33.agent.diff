+/** A CSV value: wrapped in double quotes, inner quotes doubled, when it holds a comma, quote or line break. */
+function csvCell(value: string): string {
+  return /[",\r\n]/.test(value) ? '"' + value.replace(/"/g, '""') + '"' : value;
