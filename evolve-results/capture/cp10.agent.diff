diff --git a/src/main/resources/db/migration/V9__claim_settled_due.sql b/src/main/resources/db/migration/V9__claim_settled_due.sql
new file mode 100644
index 000000000..0fe2816fc
--- /dev/null
+++ b/src/main/resources/db/migration/V9__claim_settled_due.sql
@@ -0,0 +1,4 @@
+-- A claim's due as it was when it was settled: its amount times its person's grade's rate then,
+-- rounded half up to cents. Null while the claim is not settled, or when the grade had no rate
+-- (that due stays live).
+ALTER TABLE claim ADD COLUMN settled_due DECIMAL(14, 2);
