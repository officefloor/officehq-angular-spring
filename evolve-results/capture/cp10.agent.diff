diff --git a/src/main/resources/db/migration/V9__claim_settled_due.sql b/src/main/resources/db/migration/V9__claim_settled_due.sql
new file mode 100644
index 000000000..46d1f2fb5
--- /dev/null
+++ b/src/main/resources/db/migration/V9__claim_settled_due.sql
@@ -0,0 +1,4 @@
+-- A claim's due fixed when it is settled: the amount times its person's grade rate at that moment,
+-- kept as it was whatever the rates do later. Null for a claim not settled, or settled while the
+-- grade had no rate.
+ALTER TABLE claim ADD COLUMN settled_due DECIMAL(12, 2);
