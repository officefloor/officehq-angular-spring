diff --git a/src/main/java/net/officefloor/hq/app/person/PersonSnapshot.java b/src/main/java/net/officefloor/hq/app/person/PersonSnapshot.java
new file mode 100644
index 000000000..c9de31680
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/person/PersonSnapshot.java
@@ -0,0 +1,66 @@
+package net.officefloor.hq.app.person;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Entity;
+import jakarta.persistence.GeneratedValue;
+import jakarta.persistence.GenerationType;
+import jakarta.persistence.Id;
+import jakarta.persistence.Table;
+import java.time.LocalDate;
+
+/** One SNAPSHOT written for a person: the day being left and their due-total on it, as the SNAPSHOT recorded it. */
+@Entity
+@Table(name = "person_snapshot")
+public class PersonSnapshot {
+
+    @Id
+    @GeneratedValue(strategy = GenerationType.IDENTITY)
+    private Long id;
+
+    @Column(name = "sheet_id", nullable = false)
+    private String sheetId;
+
+    @Column(name = "person_id", nullable = false)
+    private Long personId;
+
+    @Column(name = "snapshot_day", nullable = false)
+    private LocalDate day;
+
+    @Column(name = "due_total", nullable = false)
+    private String dueTotal;
+
+    protected PersonSnapshot() {
+    }
+
+    public PersonSnapshot(String sheetId, Long personId, LocalDate day, String dueTotal) {
+        this.sheetId = sheetId;
+        this.personId = personId;
+        this.day = day;
+        this.dueTotal = dueTotal;
+    }
+
+    public Long getId() {
+        return id;
+    }
+
+    public String getSheetId() {
+        return sheetId;
+    }
+
+    public Long getPersonId() {
+        return personId;
+    }
+
+    public LocalDate getDay() {
+        return day;
+    }
+
+    public String getDueTotal() {
+        return dueTotal;
+    }
+
+    /** The line as shown: the day being left, then the due-total. */
+    public String line() {
+        return day + " " + dueTotal;
+    }
+}
