+  // The highest freeboard minus the lowest freeboard among the people not on hold (n/a freeboards
+  // skipped); null (n/a) when nobody has one.
+  protected readonly freeboardSpread = computed(() => {
+    const values = (this.people() ?? [])
+      .filter((p) => !p.hold)
+      .map((p) => p.freeboard)
+      .filter((v): v is number => v !== null);
+    return values.length === 0 ? null : Math.max(...values) - Math.min(...values);
+  });
